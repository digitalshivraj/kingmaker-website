---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappLink } from '../data/site';
import { t } from '../i18n/ui';
import { localize, stripLang, otherLang, ogLocale, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
  title: string;
  description: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  image?: string;
  noindex?: boolean;
  /** Path of the same page in the other language. Defaults to the mirrored path. */
  altPath?: string;
  /** False when the other language has no version of this page (hreflang is then omitted). */
  hasAlt?: boolean;
  /** Extra JSON-LD objects for this page (Service, SoftwareApplication, FAQPage, ...). */
  jsonLd?: Record<string, unknown>[];
}

const {
  lang = 'en',
  title,
  description,
  type = 'website',
  publishedTime,
  image = '/og.png',
  noindex = false,
  hasAlt = true,
  jsonLd = [],
} = Astro.props;
const ui = t(lang);
const path = Astro.url.pathname;
const base = stripLang(path);
const other = otherLang(lang);
const altPath = Astro.props.altPath ?? localize(base, other);

const canonical = new URL(path, Astro.site);
const siteName = lang === 'mr' ? site.marathiName : site.name;
const fullTitle = title === site.name || title === site.marathiName ? `${siteName}: ${ui.common.tagline}` : `${title} | ${siteName}`;
const ogImage = new URL(image, Astro.site);
const enUrl = new URL(localize(base, 'en'), Astro.site);
const mrUrl = new URL(localize(base, 'mr'), Astro.site);

const org = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'ProfessionalService'],
  '@id': `${site.url}/#organization`,
  name: site.name,
  alternateName: site.marathiName,
  description: ui.common.siteDesc,
  url: site.url,
  logo: { '@type': 'ImageObject', url: new URL('/favicon-512.png', Astro.site).toString(), width: 512, height: 512 },
  image: new URL('/og.png', Astro.site).toString(),
  email: site.email,
  telephone: site.phoneIntl,
  foundingDate: String(site.since),
  founder: { '@type': 'Person', name: site.proprietor },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Parbhani',
    addressRegion: 'Maharashtra',
    addressCountry: 'IN',
  },
  areaServed: [
    { '@type': 'State', name: 'Maharashtra' },
    { '@type': 'Country', name: 'India' },
  ],
  knowsLanguage: ['mr', 'en'],
  openingHours: 'Mo-Sa 10:00-19:00',
  priceRange: '₹₹',
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: site.phoneIntl,
    email: site.email,
    contactType: 'sales',
    availableLanguage: ['Marathi', 'English'],
  },
  sameAs: [site.whatsapp],
  identifier: [
    { '@type': 'PropertyValue', propertyID: 'Udyam', value: site.udyam },
    { '@type': 'PropertyValue', propertyID: 'GSTIN', value: site.gstin },
  ],
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: site.url,
  name: site.name,
  alternateName: site.marathiName,
  inLanguage: ['en', 'mr'],
  publisher: { '@id': `${site.url}/#organization` },
};
const webpage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: canonical.toString(),
  name: title,
  description,
  inLanguage: lang,
  isPartOf: { '@id': `${site.url}/#website` },
  about: { '@id': `${site.url}/#organization` },
  ...(publishedTime ? { datePublished: publishedTime } : {}),
};
---

<!doctype html>
<html lang={lang} class="js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      hasAlt && (
        <>
          <link rel="alternate" hreflang="en" href={enUrl} />
          <link rel="alternate" hreflang="mr" href={mrUrl} />
          <link rel="alternate" hreflang="x-default" href={enUrl} />
        </>
      )
    }
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://images.pexels.com" crossorigin />
    <link rel="dns-prefetch" href="https://images.pexels.com" />
    <meta name="theme-color" content="#0a1830" />
    <meta name="facebook-domain-verification" content="9lhcey18jmqjkbqjylvlqbmzmt9nu1" />
    <meta name="author" content={site.name} />
    <meta name="geo.region" content="IN-MH" />
    <meta name="geo.placename" content="Parbhani, Maharashtra" />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {hasAlt && <meta property="og:locale:alternate" content={ogLocale[other]} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    <script type="application/ld+json" set:html={JSON.stringify(website)} />
    <script type="application/ld+json" set:html={JSON.stringify(webpage)} />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...obj })} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{ui.nav.skip}</a>
    <Header lang={lang} altPath={altPath} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <a class="float-wa" href={whatsappLink(ui.hero.waMessage)} target="_blank" rel="noopener" aria-label={ui.nav.floatWa} title={ui.nav.floatWa}>
      <Icon name="whatsapp" size={28} />
    </a>
    <style>
      .skip {
        position: absolute;
        left: 16px;
        top: -60px;
        background: var(--gold);
        color: var(--ink);
        padding: 10px 16px;
        border-radius: 8px;
        z-index: 100;
        font-weight: 600;
      }
      .skip:focus {
        top: 12px;
      }
    </style>
    <script>
      const els = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-in'));
      } else {
        const pending = new Set(els);
        const show = (el: HTMLElement) => {
          el.classList.add('is-in');
          pending.delete(el);
          io.unobserve(el);
        };
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => e.isIntersecting && show(e.target as HTMLElement)),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
        // Safety net for fast or programmatic scrolling: anything already scrolled past is shown.
        let ticking = false;
        const sweep = () => {
          ticking = false;
          const limit = window.innerHeight * 0.95;
          pending.forEach((el) => {
            if (el.getBoundingClientRect().top < limit) show(el);
          });
        };
        window.addEventListener(
          'scroll',
          () => {
            if (!ticking && pending.size) {
              ticking = true;
              requestAnimationFrame(sweep);
            }
          },
          { passive: true },
        );
      }
    </script>
  </body>
</html>
