---
import Photo from './Photo.astro';
import type { PhotoKey } from '../data/images';
import { t } from '../i18n/ui';
import { localize, type Lang } from '../i18n/utils';
interface Props {
  lang?: Lang;
  title: string;
  marathi?: string;
  intro?: string;
  crumbs?: { label: string; href: string }[];
  photo?: PhotoKey;
}
const { lang = 'en', title, marathi, intro, crumbs = [], photo } = Astro.props;
const ui = t(lang);
const origin = Astro.site?.origin ?? '';
const breadcrumb =
  crumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [{ label: ui.nav.home, href: localize('/', lang) }, ...crumbs].map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.label,
          item: origin + c.href,
        })),
      }
    : null;
---

{breadcrumb && <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />}
<section class:list={['page-head', { 'with-photo': !!photo }]}>
  {photo && <Photo name={photo} w={900} h={600} class="head-photo" eager sizes="(max-width: 900px) 100vw, 40vw" />}
  <div class="wrap">
    {
      crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li>
              <a href={localize('/', lang)}>{ui.nav.home}</a>
            </li>
            {crumbs.map((c) => (
              <li>
                <a href={c.href}>{c.label}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <h1>{title}</h1>
    {intro && <p class="lede">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .page-head {
    background:
      radial-gradient(700px 300px at 90% 0%, rgba(127, 178, 232, 0.16), transparent 60%),
      radial-gradient(500px 260px at 0% 100%, rgba(201, 149, 46, 0.12), transparent 60%),
      var(--ink);
    color: var(--on-dark);
    padding-block: clamp(40px, 6vw, 72px);
    position: relative;
    overflow: hidden;
  }
  .page-head::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse at 30% 50%, #000 10%, transparent 70%);
    pointer-events: none;
  }
  .page-head .wrap {
    position: relative;
  }
  .with-photo .wrap {
    position: relative;
    z-index: 1;
    max-width: none;
    width: min(var(--w), 100% - 2 * var(--gutter));
  }
  .with-photo .wrap > * {
    max-width: 58%;
  }
  .head-photo {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 42%;
    height: 100%;
    object-fit: cover;
    mask-image: linear-gradient(90deg, transparent 0%, #000 35%);
    opacity: 0.9;
  }
  @media (max-width: 900px) {
    .head-photo {
      position: static;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 7;
      mask-image: none;
      margin-bottom: 24px;
    }
    .with-photo .wrap > * {
      max-width: none;
    }
  }
  .crumbs ol {
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 0.9rem;
  }
  .crumbs li + li::before {
    content: '/';
    color: var(--on-dark-muted);
    margin-right: 6px;
  }
  .crumbs a {
    color: var(--on-dark-muted);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--gold-2);
  }
  .sub {
    color: var(--gold-2);
    font-size: 1.1rem;
    margin-bottom: 8px;
  }
  h1 {
    color: var(--white);
    font-size: clamp(2rem, 4.5vw, 3rem);
  }
  .lede {
    color: var(--on-dark-muted);
  }
</style>
