---
import type { Lang } from '../i18n/utils';
interface Props {
  variant: 'lodge' | 'citizen' | 'booth' | 'subsidy' | 'idcard' | 'opd' | 'queue' | 'logistics';
  title: string;
  compact?: boolean;
  lang?: Lang;
}
const { variant, title, compact = false, lang = 'en' } = Astro.props;

const strings = {
  en: {
    lodge: { stats: ['Lodges online', 'Guests today', 'Alerts'], hd: ['Lodge', 'Guest', 'ID', 'In'], rows: [['Hotel Sai, Nanded', 'R. Patil', 'Aadhaar'], ['Lodge Godavari', 'S. Shaikh', 'DL'], ['Hotel Priya', 'A. Kumar', 'Missing'], ['Lodge Shriram', 'V. Jadhav', 'Voter']] },
    citizen: { tabs: ['Complaints', 'Meetings', 'Schemes', 'Events'], tickets: [['Road repair, Ward 4', 'Sent: PWD', '2 days'], ['Water supply, Gaothan', 'In progress: Nagar Parishad', '5 days'], ['Street lights, Shivaji Nagar', 'Resolved', 'Done'], ['Add name to ration card', 'Sent: Tahsil', '1 day']] },
    booth: { stats: ['Booths', 'Committees formed', 'New members'] },
    subsidy: { steps: ['Application', 'Documents', 'Pre-sanction', 'Purchase', 'Inspection', 'Subsidy credited'], hd: ['Farmer', 'Village', 'Stage', 'Amount'], rows: [['Santosh More', 'Chatori', 'Purchase'], ['Sunita Raut', 'Adgaon', 'Inspection'], ['Balaji Wagh', 'Palam', 'Credited']] },
    idcard: { cls: 'Class 6, PM SHRI School', qc: 'QC: 1,204 approved, 36 to recheck' },
    opd: { stats: ['OPD today', 'Waiting', 'IPD beds'], hd: ['Token', 'Patient', 'Doctor', 'Status'], rows: [['A-21', 'Ramesh Kale', 'Dr. Deshmukh', 'In room'], ['A-22', 'Savita Joshi', 'Dr. Deshmukh', 'Waiting'], ['B-07', 'Ajay Pawar', 'Dr. Rane', 'Pharmacy']] },
    queue: { app: 'Devdoot', token: 'Your token', now: 'Now serving: 11', eta: 'Estimated wait: 25 minutes', doc: 'Dr. A. Deshmukh, Paediatrics' },
    logistics: { stats: ['Bookings today', 'Franchises', 'On time'] },
  },
  mr: {
    lodge: { stats: ['लॉज ऑनलाइन', 'आजचे पाहुणे', 'अलर्ट'], hd: ['लॉज', 'पाहुणा', 'ओळखपत्र', 'वेळ'], rows: [['हॉटेल साई, नांदेड', 'र. पाटील', 'आधार'], ['लॉज गोदावरी', 'स. शेख', 'DL'], ['हॉटेल प्रिया', 'अ. कुमार', 'नाही'], ['लॉज श्रीराम', 'व. जाधव', 'मतदार']] },
    citizen: { tabs: ['तक्रारी', 'भेटी', 'योजना', 'कार्यक्रम'], tickets: [['रस्ता दुरुस्ती, वॉर्ड 4', 'पाठवले: बांधकाम विभाग', '2 दिवस'], ['पाणीपुरवठा, गावठाण', 'प्रगतीत: नगरपरिषद', '5 दिवस'], ['पथदिवे, शिवाजी नगर', 'निकाली', 'पूर्ण'], ['शिधापत्रिका नाव जोडणे', 'पाठवले: तहसील', '1 दिवस']] },
    booth: { stats: ['बूथ', 'समित्या तयार', 'नवे सदस्य'] },
    subsidy: { steps: ['अर्ज', 'कागदपत्रे', 'पूर्वसंमती', 'खरेदी', 'तपासणी', 'अनुदान जमा'], hd: ['शेतकरी', 'गाव', 'टप्पा', 'रक्कम'], rows: [['संतोष मोरे', 'चाटोरी', 'खरेदी'], ['सुनीता राऊत', 'आडगाव', 'तपासणी'], ['बालाजी वाघ', 'पालम', 'जमा']] },
    idcard: { cls: 'इयत्ता 6, PM SHRI शाळा', qc: 'तपासणी: 1,204 मंजूर, 36 पुन्हा तपासायचे' },
    opd: { stats: ['आज OPD', 'प्रतीक्षेत', 'IPD खाटा'], hd: ['टोकन', 'रुग्ण', 'डॉक्टर', 'स्थिती'], rows: [['A-21', 'रमेश काळे', 'डॉ. देशमुख', 'आत'], ['A-22', 'सविता जोशी', 'डॉ. देशमुख', 'प्रतीक्षेत'], ['B-07', 'अजय पवार', 'डॉ. राणे', 'औषधालय']] },
    queue: { app: 'देवदूत', token: 'तुमचा टोकन', now: 'सध्या सुरू: 11', eta: 'अंदाजे वेळ: 25 मिनिटे', doc: 'डॉ. ए. देशमुख, बालरोग' },
    logistics: { stats: ['आजची बुकिंग', 'फ्रँचायझी', 'वेळेवर'] },
  },
};
const T = strings[lang];
const times = ['21:10', '21:04', '20:52', '20:41'];
const amounts = ['₹ 18,500', '₹ 22,000', '₹ 18,500'];
---

<div class:list={['mock', variant, { compact }]} role="img" aria-label={`Illustration of the ${title} screen`}>
  <div class="chrome">
    <span class="dot"></span><span class="dot"></span><span class="dot"></span>
    <span class="ttl">{title}</span>
  </div>
  <div class="body">
    {
      variant === 'lodge' && (
        <>
          <div class="stats">
            <div><b>212</b><span>{T.lodge.stats[0]}</span></div>
            <div><b>1,480</b><span>{T.lodge.stats[1]}</span></div>
            <div class="warn"><b>3</b><span>{T.lodge.stats[2]}</span></div>
          </div>
          <div class="rows">
            <div class="row hd">{T.lodge.hd.map((h) => <span>{h}</span>)}</div>
            {T.lodge.rows.map((r, i) => (
              <div class:list={['row', { flag: i === 2 }]}><span>{r[0]}</span><span>{r[1]}</span><span>{r[2]}</span><span>{times[i]}</span></div>
            ))}
          </div>
        </>
      )
    }
    {
      variant === 'citizen' && (
        <>
          <div class="tabs">{T.citizen.tabs.map((t, i) => <span class:list={{ on: i === 0 }}>{t}</span>)}</div>
          <div class="tickets">
            {T.citizen.tickets.map((t, i) => (
              <div class="ticket"><i class:list={['st', ['open', 'prog', 'done', 'open'][i]]} /><div><b>{t[0]}</b><span>{t[1]}</span></div><em>{t[2]}</em></div>
            ))}
          </div>
        </>
      )
    }
    {
      variant === 'booth' && (
        <>
          <div class="stats">
            <div><b>351</b><span>{T.booth.stats[0]}</span></div>
            <div><b>298</b><span>{T.booth.stats[1]}</span></div>
            <div><b>12,340</b><span>{T.booth.stats[2]}</span></div>
          </div>
          <div class="wall" aria-hidden="true">
            {Array.from({ length: 60 }).map((_, i) => (
              <i class={i % 7 === 3 || i % 11 === 5 ? 'pending' : i % 13 === 2 ? 'gap' : ''} />
            ))}
          </div>
        </>
      )
    }
    {
      variant === 'subsidy' && (
        <>
          <div class="steps">
            {T.subsidy.steps.map((st, i) => <span class:list={{ done: i < 3, on: i === 3 }}>{st}</span>)}
          </div>
          <div class="rows">
            <div class="row hd">{T.subsidy.hd.map((h) => <span>{h}</span>)}</div>
            {T.subsidy.rows.map((r, i) => (
              <div class="row"><span>{r[0]}</span><span>{r[1]}</span><span>{r[2]}</span><span>{amounts[i]}</span></div>
            ))}
          </div>
        </>
      )
    }
    {
      variant === 'idcard' && (
        <div class="cards">
          {['Aarav Kumar', 'Priya Singh', 'Rohan Das'].map((n) => (
            <div class="card">
              <i class="photo" />
              <b>{n}</b>
              <span>{T.idcard.cls}</span>
              <i class="qr" />
            </div>
          ))}
          <div class="qc">{T.idcard.qc}</div>
        </div>
      )
    }
    {
      variant === 'opd' && (
        <>
          <div class="stats">
            <div><b>47</b><span>{T.opd.stats[0]}</span></div>
            <div><b>12</b><span>{T.opd.stats[1]}</span></div>
            <div><b>8</b><span>{T.opd.stats[2]}</span></div>
          </div>
          <div class="rows">
            <div class="row hd">{T.opd.hd.map((h) => <span>{h}</span>)}</div>
            {T.opd.rows.map((r) => (
              <div class="row"><span>{r[0]}</span><span>{r[1]}</span><span>{r[2]}</span><span>{r[3]}</span></div>
            ))}
          </div>
        </>
      )
    }
    {
      variant === 'queue' && (
        <div class="phone">
          <div class="ph-top">{T.queue.app}</div>
          <div class="token">
            <span>{T.queue.token}</span>
            <b>14</b>
            <span>{T.queue.now}</span>
          </div>
          <div class="eta">{T.queue.eta}</div>
          <div class="doc">{T.queue.doc}</div>
        </div>
      )
    }
    {
      variant === 'logistics' && (
        <>
          <div class="stats">
            <div><b>128</b><span>{T.logistics.stats[0]}</span></div>
            <div><b>19</b><span>{T.logistics.stats[1]}</span></div>
            <div><b>96%</b><span>{T.logistics.stats[2]}</span></div>
          </div>
          <div class="track">
            <span class="done">Booked</span><span class="done">Picked up</span><span class="on">In transit</span><span>Out for delivery</span><span>Delivered</span>
          </div>
          <div class="rows">
            <div class="row hd"><span>AWB</span><span>Route</span><span>Franchise</span><span>Status</span></div>
            <div class="row"><span>MH 48213</span><span>Pune to Patna</span><span>Hadapsar</span><span>In transit</span></div>
            <div class="row"><span>MH 48219</span><span>Mumbai to Muzaffarpur</span><span>Thane</span><span>Picked up</span></div>
          </div>
        </>
      )
    }
  </div>
</div>

<style>
  .mock {
    background: var(--white);
    border-radius: 14px;
    box-shadow: var(--shadow);
    border: 1px solid var(--line);
    overflow: hidden;
    font-size: 13px;
    line-height: 1.35;
    color: var(--text);
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: var(--navy);
    color: var(--on-dark);
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
  }
  .ttl {
    margin-left: 8px;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 500;
  }
  .body {
    padding: 14px;
    display: grid;
    gap: 12px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  .stats div {
    background: var(--paper);
    border-radius: 8px;
    padding: 8px 10px;
    display: grid;
  }
  .stats b {
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--navy);
  }
  .stats span {
    font-size: 11px;
    color: var(--muted);
  }
  .stats .warn b {
    color: #b43c1e;
  }
  .rows {
    display: grid;
    gap: 2px;
  }
  .row {
    display: grid;
    grid-template-columns: 1.5fr 1fr 0.9fr 0.7fr;
    gap: 8px;
    padding: 7px 8px;
    border-radius: 6px;
    white-space: nowrap;
    overflow: hidden;
  }
  .row span {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .row.hd {
    color: var(--muted);
    font-size: 11px;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
  }
  .row:not(.hd):nth-child(odd) {
    background: var(--paper);
  }
  .row.flag {
    background: #fdf1ec;
    color: #8f2d13;
  }
  .tabs {
    display: flex;
    gap: 6px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 6px;
  }
  .tabs span {
    padding: 4px 10px;
    border-radius: 999px;
    color: var(--muted);
  }
  .tabs .on {
    background: var(--navy);
    color: var(--white);
  }
  .tickets {
    display: grid;
    gap: 6px;
  }
  .ticket {
    display: grid;
    grid-template-columns: 10px 1fr auto;
    gap: 10px;
    align-items: center;
    padding: 8px 10px;
    background: var(--paper);
    border-radius: 8px;
  }
  .ticket div {
    display: grid;
  }
  .ticket span {
    font-size: 11px;
    color: var(--muted);
  }
  .ticket em {
    font-style: normal;
    font-size: 11px;
    color: var(--muted);
  }
  .st {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .st.open {
    background: #d9822b;
  }
  .st.prog {
    background: var(--signal);
  }
  .st.done {
    background: #2e9e63;
  }
  .wall {
    display: grid;
    grid-template-columns: repeat(15, 1fr);
    gap: 4px;
  }
  .wall i {
    aspect-ratio: 1;
    border-radius: 3px;
    background: #2e9e63;
  }
  .wall i.pending {
    background: var(--gold);
  }
  .wall i.gap {
    background: var(--line);
  }
  .steps,
  .track {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }
  .steps span,
  .track span {
    flex: 1;
    text-align: center;
    padding: 5px 4px;
    font-size: 11px;
    background: var(--paper-2);
    color: var(--muted);
    border-radius: 4px;
    white-space: nowrap;
  }
  .steps .done,
  .track .done {
    background: #dff3e7;
    color: #1f6b43;
  }
  .steps .on,
  .track .on {
    background: var(--navy);
    color: var(--white);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  .card {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 8px;
    display: grid;
    gap: 3px;
    font-size: 11px;
    background: linear-gradient(var(--navy) 0 18px, var(--white) 18px);
    padding-top: 24px;
  }
  .card .photo {
    width: 34px;
    height: 40px;
    background: var(--paper-2);
    border-radius: 4px;
    border: 1px solid var(--line);
  }
  .card b {
    font-size: 12px;
  }
  .card span {
    color: var(--muted);
  }
  .card .qr {
    width: 22px;
    height: 22px;
    background:
      linear-gradient(90deg, var(--navy) 50%, transparent 50%) 0 0/6px 6px,
      linear-gradient(var(--navy) 50%, transparent 50%) 0 0/6px 6px;
    justify-self: end;
  }
  .qc {
    grid-column: 1 / -1;
    font-size: 11px;
    color: var(--muted);
    padding-top: 4px;
    border-top: 1px solid var(--line);
  }
  .phone {
    width: 170px;
    margin: 0 auto;
    border: 2px solid var(--navy);
    border-radius: 18px;
    padding: 10px;
    display: grid;
    gap: 8px;
    text-align: center;
  }
  .ph-top {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--navy);
  }
  .token {
    background: var(--navy);
    color: var(--white);
    border-radius: 12px;
    padding: 10px;
    display: grid;
  }
  .token b {
    font-family: var(--font-display);
    font-size: 36px;
    line-height: 1;
    color: var(--gold-2);
    margin: 4px 0;
  }
  .token span {
    font-size: 11px;
  }
  .eta,
  .doc {
    font-size: 11px;
    color: var(--muted);
  }
  .compact {
    font-size: 11px;
  }
  .compact .body {
    padding: 10px;
    gap: 8px;
  }
  .compact .stats b {
    font-size: 15px;
  }
</style>
