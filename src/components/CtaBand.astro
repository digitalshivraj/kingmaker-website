---
import Icon from './Icon.astro';
import { site, whatsappLink } from '../data/site';
import { t } from '../i18n/ui';
import { localize, type Lang } from '../i18n/utils';
interface Props {
  lang?: Lang;
  title?: string;
  text?: string;
  message?: string;
}
const { lang = 'en' } = Astro.props;
const ui = t(lang);
const p = ui.x.prefooter;
const { title, text = ui.cta.text, message = ui.cta.message } = Astro.props;
const L = (path: string) => localize(path, lang);
const links = [
  { label: p.wa, href: whatsappLink(message), icon: 'whatsapp', ext: true },
  { label: p.mail, href: `mailto:${site.email}`, icon: 'mail', ext: false },
  { label: p.contact, href: L('/contact/'), icon: 'arrow', ext: false },
  { label: p.gov, href: L('/government/'), icon: 'landmark', ext: false },
];
---

<section class="cta-band">
  <div class="wrap inner">
    <div class="say" data-reveal>
      {
        title ? (
          <h2 class="d-md">{title}</h2>
        ) : (
          <h2 class="d-lg">
            {p.big[0]}
            <br />
            <span class="sky">{p.big[1]}</span>
          </h2>
        )
      }
      <p>{text}</p>
    </div>
    <ul class="links" data-reveal style="--rd: 0.1s">
      {
        links.map((l) => (
          <li>
            <a href={l.href} target={l.ext ? '_blank' : undefined} rel={l.ext ? 'noopener' : undefined}>
              <span>{l.label}</span>
              <Icon name={l.icon} size={20} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cta-band {
    background: var(--navy);
    color: var(--on-dark);
    padding-block: clamp(64px, 9vw, 120px);
  }
  .inner {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  h2 {
    color: var(--white);
    margin-bottom: 22px;
  }
  .say p {
    color: var(--on-dark-muted);
    font-size: 1.15rem;
    max-width: 52ch;
  }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 24px;
    border-radius: 999px;
    background: var(--sky-2);
    color: var(--navy);
    text-decoration: none;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 1.02rem;
    transition: background 0.2s, transform 0.2s var(--ease);
  }
  html[lang='mr'] .links a {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .links a:hover {
    background: var(--white);
    transform: translateX(4px);
    color: var(--navy);
  }
  .links li:first-child a {
    background: var(--gold);
    color: var(--ink);
  }
  .links li:first-child a:hover {
    background: var(--gold-2);
  }
  @media (max-width: 860px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
