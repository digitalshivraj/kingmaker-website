---
import Icon from './Icon.astro';
import { site, whatsappLink } from '../data/site';
interface Props {
  title?: string;
  text?: string;
  message?: string;
}
const {
  title = 'Tell us what your office or business needs',
  text = 'Send a message on WhatsApp or email. We reply within one working day, in Marathi or English, and set up a free demo link before you pay anything.',
  message = 'Hello Kingmaker Enterprises, I want to discuss a project.',
} = Astro.props;
---

<section class="band">
  <div class="wrap inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="actions">
      <a class="btn gold" href={whatsappLink(message)} target="_blank" rel="noopener">
        <Icon name="whatsapp" />
        <span>WhatsApp {site.phoneDisplay}</span>
      </a>
      <a class="btn ghost-light" href={`mailto:${site.email}`}>
        <Icon name="mail" />
        <span>{site.email}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .band {
    background: linear-gradient(120deg, var(--navy) 0%, var(--navy-3) 100%);
    color: var(--on-dark);
    padding-block: clamp(48px, 7vw, 80px);
  }
  .inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 32px;
    align-items: center;
  }
  h2 {
    color: var(--white);
  }
  p {
    color: var(--on-dark-muted);
    max-width: 52ch;
  }
  .actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }
  @media (max-width: 800px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
