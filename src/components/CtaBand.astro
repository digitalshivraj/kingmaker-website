---
import Icon from './Icon.astro';
import { site, whatsappLink } from '../data/site';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/utils';
interface Props {
  lang?: Lang;
  title?: string;
  text?: string;
  message?: string;
}
const { lang = 'en' } = Astro.props;
const ui = t(lang);
const { title = ui.cta.title, text = ui.cta.text, message = ui.cta.message } = Astro.props;
---

<section class="band">
  <div class="wrap inner">
    <div data-reveal>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="actions" data-reveal style="--rd: 0.1s">
      <a class="btn gold" href={whatsappLink(message)} target="_blank" rel="noopener">
        <Icon name="whatsapp" />
        <span>{ui.cta.wa} {site.phoneDisplay}</span>
      </a>
      <a class="btn ghost-light" href={`mailto:${site.email}`}>
        <Icon name="mail" />
        <span>{site.email}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .band {
    position: relative;
    background: linear-gradient(120deg, var(--navy) 0%, var(--navy-3) 100%);
    color: var(--on-dark);
    padding-block: clamp(48px, 7vw, 80px);
    overflow: hidden;
  }
  .band::after {
    content: '';
    position: absolute;
    right: -120px;
    top: -120px;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(201, 149, 46, 0.28), transparent 65%);
    pointer-events: none;
  }
  .inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 32px;
    align-items: center;
  }
  h2 {
    color: var(--white);
  }
  p {
    color: var(--on-dark-muted);
    max-width: 52ch;
  }
  .actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }
  @media (max-width: 800px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
