---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { t, navLinks } from '../i18n/ui';
import { localize, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const links = navLinks(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <div class="col about">
      <img src="/logo-white.svg" alt="Kingmaker Enterprises" width="204" height="65" />
      <p>{ui.footer.about}</p>
    </div>
    <div class="col">
      <h4>{ui.footer.pages}</h4>
      <ul>
        {links.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
        <li><a href={localize('/privacy/', lang)}>{ui.footer.privacy}</a></li>
        <li><a href={localize('/terms/', lang)}>{ui.footer.terms}</a></li>
      </ul>
    </div>
    <div class="col">
      <h4>{ui.footer.contact}</h4>
      <ul class="contact">
        <li>
          <Icon name="whatsapp" size={18} />
          <a href={site.whatsapp} target="_blank" rel="noopener">{site.phoneDisplay} {ui.footer.waLabel}</a>
        </li>
        <li>
          <Icon name="phone" size={18} />
          <a href={`tel:${site.phoneIntl}`}>{site.phoneDisplay}</a>
        </li>
        <li>
          <Icon name="mail" size={18} />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <Icon name="pin" size={18} />
          <span>{ui.common.address}</span>
        </li>
        <li>
          <Icon name="clock" size={18} />
          <span>{ui.common.hours}</span>
        </li>
      </ul>
    </div>
    <div class="col">
      <h4>{ui.footer.registered}</h4>
      <ul class="reg">
        <li><span>{ui.footer.legalName}</span>{ui.common.legalName}</li>
        <li><span>{ui.footer.udyam}</span>{site.udyam}</li>
        <li><span>{ui.footer.gstin}</span>{site.gstin}</li>
        <li><span>{ui.footer.shopAct}</span>{site.shopAct}</li>
        <li><span>{ui.footer.since}</span>{site.since}</li>
      </ul>
    </div>
  </div>
  <div class="wrap legal">
    <span>{ui.footer.copyright(year)}</span>
    <span>{ui.footer.place}</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--on-dark-muted);
    padding-top: clamp(48px, 7vw, 80px);
    font-size: 0.95rem;
    border-top: 3px solid var(--gold);
  }
  .grid {
    display: grid;
    grid-template-columns: 1.4fr 0.7fr 1.1fr 1.1fr;
    gap: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--line-dark);
  }
  .about img {
    height: 54px;
    width: auto;
    margin-bottom: 12px;
  }
  .about .marathi {
    color: var(--gold-2);
    margin-bottom: 10px;
  }
  .about p {
    max-width: 38ch;
  }
  h4 {
    color: var(--white);
    margin-bottom: 14px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }
  a {
    color: var(--on-dark);
    text-decoration: none;
  }
  a:hover {
    color: var(--gold-2);
  }
  .contact li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 10px;
    align-items: start;
  }
  .contact svg {
    margin-top: 4px;
    color: var(--gold-2);
  }
  .reg li {
    display: grid;
    gap: 1px;
    color: var(--on-dark);
  }
  .reg span {
    font-size: 0.8rem;
    color: var(--on-dark-muted);
  }
  .legal {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-block: 20px 28px;
    font-size: 0.88rem;
  }
  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .legal {
      padding-bottom: 90px;
    }
  }
</style>
