---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import PhotoMock from '../components/PhotoMock.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { whatsappLink } from '../data/site';
import { t } from '../i18n/ui';
import { localize, byLang, entrySlug, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  product: CollectionEntry<'products'>;
}
const { lang, product } = Astro.props;
const ui = t(lang);
const L = (p: string) => localize(p, lang);
const { Content } = await render(product);
const all = byLang(await getCollection('products'), lang).sort((a, b) => a.data.order - b.data.order);
const others = all.filter((p) => p.id !== product.id).slice(0, 3);
const wa = whatsappLink(ui.productPage.demoMsg(product.data.title));
const slug = entrySlug(product.id);
const origin = Astro.site?.origin ?? '';
const productLd = {
  '@type': 'SoftwareApplication',
  name: product.data.title,
  alternateName: product.data.marathi,
  description: `${product.data.tagline} ${product.data.highlights.join('. ')}.`,
  url: origin + L(`/products/${slug}/`),
  inLanguage: lang,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web, Android',
  featureList: product.data.highlights,
  audience: { '@type': 'Audience', audienceType: product.data.users.join(', ') },
  author: { '@id': `${origin}/#organization` },
  provider: { '@id': `${origin}/#organization` },
  offers: { '@type': 'Offer', availability: 'https://schema.org/InStock', priceCurrency: 'INR', description: ui.productPage.ctaText },
};
---

<Base lang={lang} title={product.data.title} description={`${product.data.title}: ${product.data.tagline} ${product.data.highlights[0]}.`} jsonLd={[productLd]}>
  <PageHead
    lang={lang}
    title={product.data.title}
    marathi={product.data.marathi}
    intro={product.data.tagline}
    crumbs={[
      { label: ui.nav.products, href: L('/products/') },
      { label: product.data.title, href: L(`/products/${slug}/`) },
    ]}
  />

  <section class="section top">
    <div class="wrap grid">
      <div>
        <h2>{ui.productPage.what}</h2>
        <ul class="check-list big">
          {product.data.highlights.map((h) => <li>{h}</li>)}
        </ul>
        <div class="actions">
          <a class="btn gold" href={wa} target="_blank" rel="noopener">
            <Icon name="whatsapp" />
            <span>{ui.productPage.demo}</span>
          </a>
          <span class="status">{product.data.status}</span>
        </div>
      </div>
      <div class="visual">
        <PhotoMock photo={product.data.photo} variant={product.data.mock} title={product.data.title} eager lang={lang} />
      </div>
    </div>
  </section>

  <section class="section paper">
    <div class="wrap layout">
      <div class="prose">
        <Content />
      </div>
      <aside>
        <div class="box">
          <h3>{ui.productPage.users}</h3>
          <ul class="plain">
            {product.data.users.map((u) => <li>{u}</li>)}
          </ul>
        </div>
        <div class="box">
          <h3>{ui.productPage.sector}</h3>
          <p>{product.data.sector}</p>
        </div>
        <div class="box">
          <h3>{ui.productPage.others}</h3>
          <ul class="plain">
            {others.map((o) => <li><a href={L(`/products/${entrySlug(o.id)}/`)}>{o.data.title}</a></li>)}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <CtaBand lang={lang} title={ui.productPage.ctaTitle(product.data.title)} text={ui.productPage.ctaText} message={ui.productPage.demoMsg(product.data.title)} />
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: center;
  }
  .big {
    font-size: 1.08rem;
    gap: 14px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 28px;
  }
  .status {
    font-size: 0.88rem;
    color: var(--navy);
    background: var(--paper-2);
    padding: 4px 12px;
    border-radius: 999px;
  }
  .layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  .box {
    background: var(--white);
    border-radius: var(--r);
    padding: 22px;
    margin-bottom: 20px;
  }
  .box h3 {
    font-size: 1.05rem;
    margin-bottom: 10px;
  }
  .box p {
    color: var(--muted);
  }
  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .grid,
    .layout {
      grid-template-columns: 1fr;
    }
  }
</style>
