---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';
import { getCollection } from 'astro:content';
import { t } from '../i18n/ui';
import { localize, byLang, entrySlug, fmtDate, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const L = (p: string) => localize(p, lang);
const all = await getCollection('blog');
const byDate = (a: { data: { date: Date } }, b: { data: { date: Date } }) => b.data.date.valueOf() - a.data.date.valueOf();
const posts = byLang(all, lang).sort(byDate);
const enOnly = lang === 'mr' ? byLang(all, 'en').sort(byDate).filter((p) => !posts.some((o) => entrySlug(o.id) === entrySlug(p.id))) : [];
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
const desc =
  lang === 'mr'
    ? 'किंगमेकर एंटरप्रायझेसचे लेख: महाराष्ट्रातील शासकीय कार्यालये, पोलीस, हॉस्पिटल, राजकीय संघटना आणि व्यवसायांसाठी सॉफ्टवेअरची सोपी माहिती.'
    : 'Articles from Kingmaker Enterprises on software for government offices, police, hospitals, political organisations and businesses in Maharashtra, written in plain language.';
---

<Base lang={lang} title={ui.blog.title} description={desc}>
  <PageHead lang={lang} title={ui.blog.title} marathi={lang === 'mr' ? 'Blog' : 'लेख'} intro={ui.blog.intro} crumbs={[{ label: ui.nav.blog, href: L('/blog/') }]}>
    <p class="tags">{tags.map((tg) => <span>{tg}</span>)}</p>
  </PageHead>

  <section class="section">
    <div class="wrap">
      <div class="posts">
        {
          posts.map((p, i) => {
            const href = L(`/blog/${entrySlug(p.id)}/`);
            return (
              <article data-reveal style={`--rd: ${(i % 2) * 0.08}s`}>
                <a href={href} class="cover" aria-hidden="true" tabindex="-1">
                  <Photo name={p.data.cover} w={720} h={420} sizes="(max-width: 760px) 100vw, 50vw" />
                </a>
                <div class="meta">
                  <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date, lang)}</time>
                  <span>
                    {p.data.readingMinutes} {ui.blog.minRead}
                  </span>
                </div>
                <h2>
                  <a href={href}>{p.data.title}</a>
                </h2>
                <p>{p.data.description}</p>
                <div class="post-tags">
                  {p.data.tags.map((tg) => (
                    <span>{tg}</span>
                  ))}
                </div>
              </article>
            );
          })
        }
      </div>

      {
        enOnly.length > 0 && (
          <div class="en-block">
            <div class="head">
              <h2>{ui.blog.inEnglish}</h2>
              <p>{ui.blog.englishNote}</p>
            </div>
            <ul class="en-list" lang="en">
              {enOnly.map((p) => (
                <li data-reveal>
                  <a href={localize(`/blog/${entrySlug(p.id)}/`, 'en')} class="cover" aria-hidden="true" tabindex="-1">
                    <Photo name={p.data.cover} w={360} h={220} sizes="160px" />
                  </a>
                  <div>
                    <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date, 'en')}</time>
                    <h3>
                      <a href={localize(`/blog/${entrySlug(p.id)}/`, 'en')}>{p.data.title}</a>
                    </h3>
                    <p>{p.data.description}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }
  .tags span {
    font-size: 0.85rem;
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: var(--on-dark-muted);
  }
  .posts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px 56px;
  }
  .cover {
    display: block;
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 16px;
  }
  .cover img {
    width: 100%;
    height: auto;
    aspect-ratio: 720 / 420;
    object-fit: cover;
    transition: transform 0.4s;
  }
  article:hover .cover img {
    transform: scale(1.03);
  }
  .meta {
    display: flex;
    gap: 16px;
    font-size: 0.88rem;
    color: var(--muted);
  }
  h2 {
    font-size: 1.45rem;
    margin: 10px 0 8px;
  }
  h2 a {
    color: var(--navy);
    text-decoration: none;
  }
  h2 a:hover {
    color: var(--gold-3);
  }
  article p {
    color: var(--muted);
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }
  .post-tags span {
    font-size: 0.8rem;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--paper-2);
    color: var(--navy);
  }
  .en-block {
    margin-top: clamp(48px, 7vw, 80px);
    padding-top: clamp(32px, 5vw, 48px);
    border-top: 2px solid var(--line);
  }
  .en-block .head h2 {
    font-size: 1.5rem;
  }
  .en-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px 40px;
  }
  .en-list li {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 16px;
    align-items: start;
  }
  .en-list .cover {
    margin: 0;
    border-radius: 10px;
  }
  .en-list .cover img {
    aspect-ratio: 360 / 220;
  }
  .en-list time {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .en-list h3 {
    font-size: 1.05rem;
    margin: 4px 0 4px;
  }
  .en-list h3 a {
    color: var(--navy);
    text-decoration: none;
  }
  .en-list h3 a:hover {
    color: var(--gold-3);
  }
  .en-list p {
    font-size: 0.92rem;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .posts,
    .en-list {
      grid-template-columns: 1fr;
    }
    .en-list li {
      grid-template-columns: 120px 1fr;
    }
  }
</style>
