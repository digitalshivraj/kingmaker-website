---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { postCats, newsCats } from '../data/groups';
import { t } from '../i18n/ui';
import { localize, byLang, isPublished, entrySlug, fmtDate, fmtDateShort, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const xc = ui.x.common;
const L = (p: string) => localize(p, lang);
const all = await getCollection('blog', isPublished);
const byDate = (a: { data: { date: Date } }, b: { data: { date: Date } }) => b.data.date.valueOf() - a.data.date.valueOf();
const posts = byLang(all, lang).sort(byDate);
const enTags = new Map(byLang(all, 'en').map((p) => [entrySlug(p.id), p.data.tags]));
const catOf = (slug: string) => postCats(enTags.get(slug) ?? []);
const [featured, ...rest] = posts;
const enOnly = lang === 'mr' ? byLang(all, 'en').sort(byDate).filter((p) => !posts.some((o) => entrySlug(o.id) === entrySlug(p.id))) : [];
const tabLabels = [xc.all, ...ui.x.home.newsTabs.slice(1)];
const PAGE = 12;
const desc =
  lang === 'mr'
    ? 'किंगमेकर एंटरप्रायझेसचे लेख: महाराष्ट्रातील शासकीय कार्यालये, पोलीस, हॉस्पिटल, राजकीय संघटना आणि व्यवसायांसाठी सॉफ्टवेअरची सोपी माहिती.'
    : 'Articles from Kingmaker Enterprises on software for government offices, police, hospitals, political organisations and businesses in Maharashtra, written in plain language.';
const list = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: posts.slice(0, 30).map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(L(`/blog/${entrySlug(p.id)}/`), Astro.site ?? 'https://kingmakerenterprises.in').toString(),
    name: p.data.title,
  })),
};
---

<Base lang={lang} title={ui.blog.title} description={desc}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(list)} />
  <PageHead lang={lang} title={ui.x.nav.insights} variant="plain" intro={ui.blog.intro} crumbs={[{ label: ui.nav.blog, href: L('/blog/') }]} />

  {
    featured && (
      <section class="section tight">
        <div class="wrap wide">
          <a class="feat" href={L(`/blog/${entrySlug(featured.id)}/`)} data-reveal>
            <span class="feat-ph">
              <Photo name={featured.data.cover} w={1100} h={720} eager sizes="(max-width: 900px) 100vw, 60vw" />
            </span>
            <span class="feat-text">
              <span class="kicker">{xc.latest}</span>
              <span class="feat-title">{featured.data.title}</span>
              <span class="feat-desc">{featured.data.description}</span>
              <span class="feat-meta">
                <time datetime={featured.data.date.toISOString()}>{fmtDate(featured.data.date, lang)}</time>
                <span>
                  {featured.data.readingMinutes} {ui.blog.minRead}
                </span>
              </span>
              <span class="btn sky">
                {xc.readMore}
                <Icon name="arrow" size={18} />
              </span>
            </span>
          </a>
        </div>
      </section>
    )
  }

  <section class="section tight">
    <div class="wrap">
      <div class="bar">
        <div class="tabs" role="tablist" aria-label={ui.blog.title} data-blog-tabs>
          {
            tabLabels.map((label, i) => (
              <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-filter={newsCats[i]}>
                {label}
              </button>
            ))
          }
        </div>
        <label class="search">
          <Icon name="search" size={18} />
          <span class="sr-only">{xc.search}</span>
          <input type="search" placeholder={xc.search} data-blog-search autocomplete="off" />
        </label>
      </div>

      <ul class="grid" id="post-grid" data-page={PAGE}>
        {
          rest.map((p, i) => {
            const slug = entrySlug(p.id);
            const text = [p.data.title, p.data.description, ...p.data.tags].join(' ').toLowerCase();
            return (
              <li data-cat={catOf(slug).join(' ')} data-text={text} class:list={{ clip: i >= PAGE }}>
                <a class="photo-card" href={L(`/blog/${slug}/`)}>
                  <span class="ph">
                    <Photo name={p.data.cover} w={640} h={420} sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 400px" />
                    <span class="chip">{p.data.tags[0]}</span>
                  </span>
                  <span class="meta">
                    <time datetime={p.data.date.toISOString()}>{fmtDateShort(p.data.date, lang)}</time>
                    <span>
                      {p.data.readingMinutes} {ui.blog.minRead}
                    </span>
                  </span>
                  <h3>{p.data.title}</h3>
                  <p class="desc">{p.data.description}</p>
                </a>
              </li>
            );
          })
        }
      </ul>
      <p class="empty" hidden>{xc.noResults}</p>
      <div class="center more-row">
        <button class="btn navy" type="button" data-more hidden={rest.length <= PAGE}>
          {xc.showMore}
        </button>
      </div>

      {
        enOnly.length > 0 && (
          <div class="en-block">
            <h2 class="d-sm">{ui.blog.inEnglish}</h2>
            <p>{ui.blog.englishNote}</p>
            <ul class="en-list" lang="en">
              {enOnly.map((p) => (
                <li>
                  <a href={localize(`/blog/${entrySlug(p.id)}/`, 'en')}>{p.data.title}</a>
                  <time datetime={p.data.date.toISOString()}>{fmtDateShort(p.data.date, 'en')}</time>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>

<script>
  const grid = document.getElementById('post-grid');
  const tabs = document.querySelector<HTMLElement>('[data-blog-tabs]');
  const search = document.querySelector<HTMLInputElement>('[data-blog-search]');
  const moreBtn = document.querySelector<HTMLButtonElement>('[data-more]');
  const empty = document.querySelector<HTMLElement>('.empty');
  if (grid && tabs && moreBtn) {
    const page = Number(grid.dataset.page) || 12;
    const items = Array.from(grid.querySelectorAll<HTMLElement>('li'));
    let filter = 'all';
    let q = '';
    let shown = page;
    const apply = () => {
      const matches = items.filter((el) => (filter === 'all' || el.dataset.cat!.split(' ').includes(filter)) && (!q || el.dataset.text!.includes(q)));
      items.forEach((el) => {
        el.hidden = !matches.includes(el);
        el.classList.remove('clip');
      });
      matches.forEach((el, i) => el.classList.toggle('clip', i >= shown));
      moreBtn.hidden = matches.length <= shown;
      if (empty) empty.hidden = matches.length > 0;
    };
    tabs.querySelectorAll<HTMLButtonElement>('button[data-filter]').forEach((btn) =>
      btn.addEventListener('click', () => {
        tabs.querySelectorAll('button').forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
        filter = btn.dataset.filter!;
        shown = page;
        apply();
      }),
    );
    search?.addEventListener('input', () => {
      q = search.value.trim().toLowerCase();
      shown = page;
      apply();
    });
    moreBtn.addEventListener('click', () => {
      shown += page;
      apply();
    });
  }
</script>

<style>
  .feat {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    border-radius: var(--r-xl);
    overflow: hidden;
    background: var(--navy);
    color: var(--on-dark);
    text-decoration: none;
    min-height: 520px;
  }
  .feat-ph {
    position: relative;
    overflow: hidden;
    background: var(--navy-2);
  }
  .feat-ph :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }
  .feat:hover .feat-ph :global(img) {
    transform: scale(1.04);
  }
  .feat-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    padding: clamp(28px, 4vw, 56px);
  }
  .feat .kicker {
    color: var(--sky);
  }
  .feat-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1.02;
    color: var(--white);
  }
  html[lang='mr'] .feat-title {
    line-height: 1.25;
  }
  .feat-desc {
    font-size: 1.05rem;
  }
  .feat-meta {
    display: flex;
    gap: 16px;
    font-size: 0.9rem;
    color: var(--on-dark-muted);
    margin-top: auto;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 18px;
    height: 52px;
    border-radius: 999px;
    background: var(--sand);
    color: var(--muted);
    min-width: min(320px, 100%);
  }
  .search input {
    border: 0;
    background: transparent;
    font: inherit;
    color: var(--text);
    width: 100%;
    outline: none;
  }
  .search:focus-within {
    box-shadow: 0 0 0 2px var(--royal);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(32px, 4vw, 48px) clamp(20px, 2.4vw, 32px);
  }
  .grid li.clip {
    display: none;
  }
  .grid .ph :global(img) {
    aspect-ratio: 640 / 420;
  }
  .meta {
    display: flex;
    gap: 14px;
    font-size: 0.86rem;
    color: var(--muted);
    margin-bottom: -6px;
  }
  .grid h3 {
    font-size: 1.2rem;
  }
  .desc {
    color: var(--muted);
    margin: 0;
    font-size: 0.97rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .empty {
    text-align: center;
    color: var(--muted);
    padding: 40px 0;
  }
  .more-row {
    margin-top: clamp(36px, 5vw, 56px);
  }
  .en-block {
    margin-top: clamp(48px, 7vw, 80px);
    padding-top: clamp(32px, 5vw, 48px);
    border-top: 1px solid var(--line);
  }
  .en-list {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 40px;
  }
  .en-list li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .en-list a {
    color: var(--navy);
    font-weight: 600;
    text-decoration: none;
  }
  .en-list time {
    color: var(--muted);
    font-size: 0.86rem;
    white-space: nowrap;
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .feat {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .feat-ph {
      aspect-ratio: 16 / 10;
    }
  }
  @media (max-width: 640px) {
    .grid,
    .en-list {
      grid-template-columns: 1fr;
    }
    .bar {
      flex-direction: column;
      align-items: stretch;
    }
    .bar .tabs {
      overflow-x: auto;
      flex-wrap: nowrap;
      scrollbar-width: none;
      max-width: 100%;
      align-self: stretch;
    }
    .search {
      min-width: 0;
      max-width: 100%;
    }
    .bar .tabs button {
      white-space: nowrap;
    }
  }
</style>
