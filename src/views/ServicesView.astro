---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import CtaBand from '../components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { canBuild } from '../data/portfolio';
import { serviceGroups, groupOf } from '../data/groups';
import { t } from '../i18n/ui';
import { localize, byLang, entrySlug, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const L = (p: string) => localize(p, lang);
const services = byLang(await getCollection('services'), lang).sort((a, b) => a.data.order - b.data.order);
const groupLabel = ui.x.nav.groups;
const itemLd = {
  '@type': 'ItemList',
  name: ui.servicesPage.title,
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.data.title,
    url: (Astro.site?.origin ?? '') + L(`/services/${entrySlug(s.id)}/`),
  })),
};
---

<Base lang={lang} title={ui.servicesPage.title} description={ui.servicesPage.desc} jsonLd={[itemLd]}>
  <PageHead
    lang={lang}
    title={ui.servicesPage.title}
    intro={ui.servicesPage.intro}
    photo="developer"
    crumbs={[{ label: ui.nav.services, href: L('/services/') }]}
  />

  <section class="section tight">
    <div class="wrap wide">
      <div class="filters">
        <div class="tabs" role="tablist" data-tabs="svc-grid">
          <button type="button" role="tab" aria-selected="true" data-filter="all">{ui.x.common.all}</button>
          {serviceGroups.map(([g]) => <button type="button" role="tab" aria-selected="false" data-filter={g}>{groupLabel[g]}</button>)}
        </div>
      </div>
      <ul class="grid" id="svc-grid">
        {
          services.map((s, i) => {
            const slug = entrySlug(s.id);
            const href = L(`/services/${slug}/`);
            return (
              <li data-cat={groupOf(slug)} data-reveal style={`--rd: ${(i % 3) * 0.06}s`}>
                <a class="photo-card svc" href={href}>
                  <span class="ph">
                    <Photo name={s.data.photo} w={720} h={520} sizes="(max-width: 700px) 100vw, 33vw" />
                    <span class="ic">
                      <Icon name={s.data.icon} size={22} />
                    </span>
                  </span>
                  <span class="txt">
                    <span class="label">{groupLabel[groupOf(slug)]}</span>
                    <h2 class="h">{s.data.title}</h2>
                    <span class="sum">{s.data.summary}</span>
                    <span class="for">{s.data.forWhom.slice(0, 3).join(', ')}</span>
                    <span class="arrow-link">
                      {ui.x.common.readMore}
                      <Icon name="arrow" size={18} />
                    </span>
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="section sand">
    <div class="wrap">
      <div class="head center">
        <h2 class="d-md" data-reveal>{ui.servicesPage.moreH2}</h2>
        <p class="intro" data-reveal>{ui.servicesPage.moreP}</p>
      </div>
      <ul class="rule-list can">
        {
          canBuild[lang].map((c, i) => (
            <li data-reveal style={`--rd: ${(i % 3) * 0.06}s`}>
              <h3>{c.name}</h3>
              <p>{c.note}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand lang={lang} title={ui.servicesPage.ctaTitle} text={ui.servicesPage.ctaText} />
</Base>

<style>
  .filters {
    display: flex;
    justify-content: center;
    margin-bottom: clamp(32px, 4vw, 48px);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(28px, 3vw, 40px) 24px;
  }
  .grid > li[hidden] {
    display: none;
  }
  .svc {
    height: 100%;
    grid-template-rows: auto 1fr;
  }
  .svc .ph {
    aspect-ratio: 720 / 520;
  }
  .ic {
    position: absolute;
    left: 16px;
    top: 16px;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: var(--white);
    color: var(--royal);
    box-shadow: 0 10px 24px -12px rgba(10, 24, 48, 0.5);
  }
  .txt {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  .txt .arrow-link {
    margin-top: auto;
    padding-top: 6px;
  }
  .h {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.9rem, 2.6vw, 2.4rem);
    line-height: 1;
    text-transform: uppercase;
    margin: 0;
    color: var(--navy);
    transition: color 0.2s;
  }
  html[lang='mr'] .h {
    text-transform: none;
    line-height: 1.2;
  }
  .svc:hover .h {
    color: var(--royal);
  }
  .sum {
    color: var(--text);
  }
  .for {
    font-size: 0.92rem;
    color: var(--muted);
  }
  .can {
    grid-template-columns: repeat(3, 1fr);
    gap: 28px 32px;
  }
  .can p {
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 1000px) {
    .grid,
    .can {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 640px) {
    .grid,
    .can {
      grid-template-columns: 1fr;
    }
  }
</style>
