---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, whatsappLink } from '../data/site';
import { projects } from '../data/portfolio';
import { t } from '../i18n/ui';
import { localize, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const g = ui.government;
const L = (p: string) => localize(p, lang);
const gov = projects.filter((p) => p.sector === 'Government and police' || p.name === 'JanSeva');
const wa = whatsappLink(g.docsMsg);
const projName = (p: (typeof projects)[number]) => (lang === 'mr' && p.marathi ? p.marathi : p.name);
const tradeName = lang === 'mr' ? `${site.marathiName} (${site.name})` : site.name;
---

<Base lang={lang} title={lang === 'mr' ? 'शासकीय आणि GeM' : 'Government and GeM'} description={g.desc}>
  <PageHead lang={lang} title={g.title} marathi={g.sub} intro={g.intro} crumbs={[{ label: ui.nav.government, href: L('/government/') }]} photo="government" />

  <section class="section">
    <div class="wrap two">
      <div data-reveal>
        <h2>{g.vendorH2}</h2>
        <p class="lede">{g.vendorP}</p>
        <table class="reg">
          <tbody>
            <tr><th>{g.rows.trade}</th><td>{tradeName}</td></tr>
            <tr><th>{g.rows.legal}</th><td>{ui.common.proprietor}</td></tr>
            <tr><th>{g.rows.constitution}</th><td>{g.rows.constitutionV(site.since)}</td></tr>
            <tr><th>{g.rows.udyam}</th><td>{site.udyam} {g.rows.udyamV}</td></tr>
            <tr><th>{g.rows.gstin}</th><td>{site.gstin}</td></tr>
            <tr><th>{g.rows.shop}</th><td>{g.rows.shopV(site.shopAct)}</td></tr>
            <tr><th>{g.rows.activities}</th><td>{g.rows.activitiesV}</td></tr>
            <tr><th>{g.rows.address}</th><td>{lang === 'mr' ? 'परभणी, महाराष्ट्र. संपूर्ण पत्ता GST आणि उद्यम प्रमाणपत्रावर, कार्यादेशासोबत दिला जातो.' : 'Parbhani, Maharashtra. Full address as on the GST and Udyam certificates, supplied with the work order.'}</td></tr>
            <tr><th>{g.rows.contact}</th><td>{site.email}, {site.phoneDisplay}</td></tr>
          </tbody>
        </table>
      </div>
      <div class="side" data-reveal style="--rd: 0.1s">
        <div class="box">
          <h3>{g.docsH3}</h3>
          <ul class="check-list">
            {g.docs.map((d) => <li>{d}</li>)}
          </ul>
          <a class="btn gold" href={wa} target="_blank" rel="noopener">
            <Icon name="whatsapp" />
            <span>{g.docsBtn}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section paper">
    <div class="wrap">
      <div class="head" data-reveal>
        <h2>{g.catH2}</h2>
        <p>{g.catP}</p>
      </div>
      <ul class="cats">
        {
          g.categories.map(([title, text], i) => (
            <li data-reveal style={`--rd: ${(i % 3) * 0.07}s`}>
              <b>{title}</b>
              <span>{text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div data-reveal>
        <h2>{g.howH2}</h2>
        <ol class="steps">
          {
            g.how.map(([title, text]) => (
              <li>
                <b>{title}</b>
                <span>{text}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <div data-reveal style="--rd: 0.1s">
        <h2>{g.dataH2}</h2>
        <ul class="check-list">
          {g.data.map((d) => <li>{d}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section paper">
    <div class="wrap">
      <div class="head" data-reveal>
        <h2>{g.workH2}</h2>
      </div>
      <ul class="gov">
        {
          gov.map((p, i) => (
            <li data-reveal style={`--rd: ${(i % 2) * 0.07}s`}>
              <b>{p.product ? <a href={L(`/products/${p.product}/`)}>{projName(p)}</a> : projName(p)}</b>
              <span>{lang === 'mr' ? p.summaryMr : p.summary}</span>
              <em>{ui.common.status[p.status]}</em>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand lang={lang} title={g.ctaTitle} text={g.ctaText} message={g.ctaMsg} />
</Base>

<style>
  .two {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: start;
  }
  .reg {
    border-collapse: collapse;
    width: 100%;
    margin-top: 20px;
  }
  .reg th,
  .reg td {
    text-align: left;
    padding: 12px 10px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .reg th {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--navy);
    width: 220px;
    font-size: 0.95rem;
  }
  html[lang='mr'] .reg th {
    font-family: var(--font-body);
    font-weight: 700;
  }
  .reg td {
    color: var(--muted);
  }
  .box {
    background: var(--paper);
    border-radius: var(--r-lg);
    padding: 28px;
    display: grid;
    gap: 18px;
    border: 1px solid var(--line);
  }
  .box h3 {
    margin: 0;
  }
  .cats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .cats li {
    display: grid;
    gap: 6px;
    padding: 20px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r);
    border-top: 3px solid var(--gold);
  }
  .cats b {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--navy);
  }
  html[lang='mr'] .cats b {
    font-family: var(--font-body);
    font-weight: 700;
  }
  .cats span {
    color: var(--muted);
    font-size: 0.97rem;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: s;
    display: grid;
    gap: 18px;
  }
  .steps li {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 14px;
    counter-increment: s;
  }
  .steps li::before {
    content: counter(s);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--navy);
    color: var(--gold-2);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 600;
    grid-row: span 2;
  }
  .steps b {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--navy);
    padding-top: 7px;
  }
  html[lang='mr'] .steps b {
    font-family: var(--font-body);
    font-weight: 700;
  }
  .steps span {
    color: var(--muted);
    grid-column: 2;
  }
  .gov {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .gov li {
    display: grid;
    gap: 4px;
    padding: 18px 20px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r);
  }
  .gov b {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--navy);
    font-size: 1.05rem;
  }
  html[lang='mr'] .gov b {
    font-family: var(--font-body);
    font-weight: 700;
  }
  .gov a {
    color: var(--navy);
    text-decoration: none;
  }
  .gov span {
    color: var(--muted);
  }
  .gov em {
    font-style: normal;
    font-size: 0.85rem;
    color: var(--gold-3);
  }
  @media (max-width: 860px) {
    .two,
    .gov {
      grid-template-columns: 1fr;
    }
    .cats {
      grid-template-columns: 1fr 1fr;
    }
    .reg th {
      width: 150px;
    }
  }
  @media (max-width: 520px) {
    .cats {
      grid-template-columns: 1fr;
    }
    .reg th,
    .reg td {
      display: block;
      width: auto;
      padding: 6px 0;
    }
    .reg td {
      padding-bottom: 14px;
    }
  }
</style>
