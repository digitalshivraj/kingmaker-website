---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PhotoMock from '../components/PhotoMock.astro';
import Photo from '../components/Photo.astro';
import CtaBand from '../components/CtaBand.astro';
import StoryPanels from '../components/StoryPanels.astro';
import { getCollection } from 'astro:content';
import { site, whatsappLink } from '../data/site';
import { projects, sectorNames, type Sector } from '../data/portfolio';
import type { PhotoKey } from '../data/images';
import { postCats, newsCats } from '../data/groups';
import { t } from '../i18n/ui';
import { localize, byLang, isPublished, entrySlug, fmtDateShort, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const x = ui.x.home;
const L = (p: string) => localize(p, lang);

const products = byLang(await getCollection('products'), lang).sort((a, b) => a.data.order - b.data.order);
const sectors = [...new Set(products.map((p) => p.data.sector))] as Sector[];
const sectorKey = (s: string) => `s${sectors.indexOf(s as Sector)}`;
const sectorLabel = (s: string) => sectorNames[s as Sector]?.[lang] ?? s;
const services = byLang(await getCollection('services'), lang).sort((a, b) => a.data.order - b.data.order);
const bento = services.slice(0, 6);
const moreServices = services.slice(6);

// Blog posts for the "What's new" carousel, with a category taken from the English tags
const allPosts = await getCollection('blog', isPublished);
const enTags = new Map(byLang(allPosts, 'en').map((p) => [entrySlug(p.id), p.data.tags]));
const catOf = (slug: string) => postCats(enTags.get(slug) ?? []);
const posts = byLang(allPosts, lang)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 18);

const stats = [
  [String(projects.length), ui.stats[0][1]],
  ['9', ui.stats[1][1]],
  [String(site.since), ui.stats[2][1]],
  ['2', ui.stats[3][1]],
];

// Word marquee: words and photo chips alternate
const chipRows: PhotoKey[][] = [
  ['team', 'police', 'developer', 'whatsapp'],
  ['citizen', 'security', 'doctor'],
  ['policeTeam', 'nurses', 'farmer', 'movers'],
];
// Darker gold and blue than the brand fills, so the words on white keep a 3:1 contrast
const wordGold = '#b07f22';
const wordSky = '#4f86c6';
const wordColors = [
  ['var(--navy)', wordGold, 'var(--royal)', wordSky],
  [wordGold, 'var(--royal)', 'var(--navy)'],
  ['var(--royal)', wordSky, wordGold, 'var(--navy)'],
];
const storyPhotos: PhotoKey[] = ['team', 'citizen', 'security'];

const faqLd = {
  '@type': 'FAQPage',
  mainEntity: ui.faq.items.map(([q, a]) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
const origin = Astro.site?.origin ?? '';
const listLd = {
  '@type': 'ItemList',
  name: ui.products.eyebrow,
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.data.title,
    url: origin + L(`/products/${entrySlug(p.id)}/`),
  })),
};
---

<Base lang={lang} title={lang === 'mr' ? site.marathiName : site.name} description={ui.common.siteDesc} jsonLd={[faqLd, listLd]}>
  <!-- Hero -->
  <section class="hero">
    <Photo name="hero" w={1800} h={1100} class="hero-bg" eager sizes="100vw" />
    <div class="hero-shade"></div>
    <div class="wrap wide hero-in">
      <p class="hero-kicker">{ui.hero.intro}</p>
      <h1>
        <span class="d-xl big">{x.heroBig[0]}</span>
        <span class="d-xl big accent">{x.heroBig[1]}</span>
        <span class="small">{x.heroSmall}</span>
      </h1>
      <p class="hero-lede">{ui.hero.lede}</p>
      <div class="btn-row">
        <a class="btn gold" href={whatsappLink(ui.hero.waMessage)} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          <span>{ui.hero.cta1}</span>
        </a>
        <a class="btn light" href={L('/products/')}>{ui.hero.cta2}</a>
      </div>
      <ul class="facts">
        {ui.hero.facts.map((f) => <li><Icon name="check" size={16} />{f}</li>)}
      </ul>
    </div>
  </section>

  <!-- Moving words -->
  <section class="words" aria-label={ui.sectorsTitle}>
    {
      x.marquee.map((row, r) => (
        <div class:list={['marquee', { reverse: r % 2 === 1 }]} style={`--dur: ${46 + r * 8}s`}>
          <div class="marquee-track">
            {[0, 1].map((copy) =>
              row.map((w, i) => (
                <>
                  <span class="word" style={`color: ${wordColors[r][i % wordColors[r].length]}`} aria-hidden={copy === 1 ? 'true' : undefined}>
                    {w}
                  </span>
                  <span class="wchip" aria-hidden="true">
                    <Photo name={chipRows[r][i % chipRows[r].length]} w={220} h={220} sizes="160px" />
                  </span>
                </>
              )),
            )}
          </div>
        </div>
      ))
    }
  </section>

  <!-- Find your platform -->
  <section class="section find">
    <div class="wrap center head">
      <h2 class="d-lg" data-reveal>{x.findH2}</h2>
      <p class="intro" data-reveal>{x.findP}</p>
      <div class="tabs" role="tablist" data-tabs="find-track" data-reveal>
        <button type="button" role="tab" aria-selected="true" data-filter="all">{x.featured}</button>
        {sectors.map((s) => <button type="button" role="tab" aria-selected="false" data-filter={sectorKey(s)}>{sectorLabel(s)}</button>)}
      </div>
    </div>
    <div class="carousel center-snap" data-carousel data-slide-label={ui.x.common.slide}>
      <ul class="track" id="find-track" tabindex="0">
        {
          products.map((p, i) => {
            const href = L(`/products/${entrySlug(p.id)}/`);
            return (
              <li class:list={['pcard', { 'is-active': i === 0 }]} data-cat={sectorKey(p.data.sector)}>
                <a href={href} class="pcard-visual" aria-label={p.data.title}>
                  <PhotoMock photo={p.data.photo} variant={p.data.mock} title={p.data.title} lang={lang} />
                </a>
                <div class="pcard-text">
                  <p class="label">{sectorLabel(p.data.sector)}</p>
                  <h3>
                    <a href={href}>{p.data.title}</a>
                  </h3>
                  <p>{p.data.tagline}</p>
                </div>
              </li>
            );
          })
        }
      </ul>
      <div class="wrap car-foot">
        <div class="dots" data-dots></div>
        <div class="arrows">
          <button class="round prev" type="button" data-prev aria-label={ui.x.common.prev}><Icon name="arrow" /></button>
          <button class="round" type="button" data-next aria-label={ui.x.common.next}><Icon name="arrow" /></button>
        </div>
      </div>
    </div>
    <div class="wrap center more-row">
      <a class="btn navy" href={L('/products/')}>{ui.products.all(projects.length)}</a>
    </div>
  </section>

  <!-- Story panels -->
  <StoryPanels
    label={ui.why.h2}
    items={x.story.map((st, i) => ({ big: st.big, text: [st.text], photo: storyPhotos[i], btn: st.btn, href: L(st.href) }))}
  />

  <!-- Services bento -->
  <section class="section ink services">
    <div class="wrap wide">
      <div class="head split">
        <div>
          <p class="kicker" data-reveal>{ui.services.eyebrow}</p>
          <h2 class="d-lg" data-reveal>{x.servicesH2}</h2>
        </div>
        <p data-reveal>{ui.services.p}</p>
      </div>
      <ul class="bento">
        {
          bento.map((s, i) => (
            <li class:list={[`b${i}`]} data-reveal style={`--rd: ${(i % 3) * 0.08}s`}>
              <a href={L(`/services/${entrySlug(s.id)}/`)}>
                <Photo name={s.data.photo} w={i === 0 ? 1000 : 700} h={i === 0 ? 900 : 520} sizes="(max-width: 760px) 100vw, 40vw" />
                <span class="b-shade" />
                <span class="b-icon">
                  <Icon name={s.data.icon} size={22} />
                </span>
                <span class="b-text">
                  <h3>{s.data.title}</h3>
                  <span class="b-sum">{s.data.summary}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="more-services" data-reveal>
        {moreServices.map((s) => <a href={L(`/services/${entrySlug(s.id)}/`)}>{s.data.title}</a>)}
        <a class="btn gold" href={L('/services/')}>{ui.services.all}</a>
      </div>
    </div>
  </section>

  <!-- Built for Maharashtra -->
  <section class="state">
    <div class="state-photo">
      <Photo name="road" w={1100} h={1000} sizes="(max-width: 860px) 100vw, 50vw" />
    </div>
    <div class="state-text">
      <h2 class="d-lg" data-reveal>
        {x.stateBig[0]}
        <br />
        <span class="accent">{x.stateBig[1]}</span>
      </h2>
      <div data-reveal>
        <p>{x.stateText}</p>
        <a class="btn sky" href={L('/about/')}>{x.stateBtn}</a>
      </div>
    </div>
  </section>

  <section class="section stats-sec">
    <div class="wrap">
      <h2 class="d-md center" data-reveal>{x.statsH2}</h2>
      <ul class="stats-grid">
        {
          stats.map(([n, label], i) => (
            <li class="stat" data-reveal style={`--rd: ${i * 0.08}s`}>
              <b>{n}</b>
              <span>{label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Process -->
  <section class="section sand process">
    <div class="wrap">
      <div class="head split">
        <div>
          <p class="kicker" data-reveal>{ui.process.eyebrow}</p>
          <h2 class="d-md" data-reveal>{ui.process.h2}</h2>
        </div>
        <p data-reveal>{ui.process.p}</p>
      </div>
      <ol class="steps">
        {
          ui.process.steps.map(([title, text], i) => (
            <li data-reveal style={`--rd: ${i * 0.07}s`}>
              <span class="num">{`0${i + 1}`}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq">
    <div class="wrap faq-grid">
      <div>
        <p class="kicker" data-reveal>{ui.faq.eyebrow}</p>
        <h2 class="d-md" data-reveal>{ui.faq.h2}</h2>
      </div>
      <div class="acc" data-reveal>
        {
          ui.faq.items.map(([q, a], i) => (
            <details open={i === 0}>
              <summary>
                <span>{q}</span>
                <i aria-hidden="true" />
              </summary>
              <p>{a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- What's new -->
  <section class="section royal news">
    <div class="wrap">
      <p class="kicker">{x.newsKicker}</p>
      <div class="news-tabs" role="tablist" data-tabs="news-track">
        {
          x.newsTabs.map((label, i) => (
            <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-filter={newsCats[i]}>
              {label}
            </button>
          ))
        }
      </div>
    </div>
    <div class="carousel" data-carousel data-slide-label={ui.x.common.slide} style="--cw: min(80%, 620px)">
      <ul class="track" id="news-track" tabindex="0">
        {
          posts.map((p) => {
            const slug = entrySlug(p.id);
            const href = L(`/blog/${slug}/`);
            return (
              <li data-cat={catOf(slug).join(' ')}>
                <a class="photo-card" href={href}>
                  <span class="ph">
                    <Photo name={p.data.cover} w={760} h={470} sizes="(max-width: 760px) 85vw, 620px" />
                    <span class="chip">{p.data.tags[0]}</span>
                  </span>
                  <h3>{p.data.title}</h3>
                  <time class="when" datetime={p.data.date.toISOString()}>{fmtDateShort(p.data.date, lang)}</time>
                </a>
              </li>
            );
          })
        }
      </ul>
      <div class="wrap car-foot">
        <div class="dots" data-dots></div>
        <div class="arrows">
          <button class="round prev" type="button" data-prev aria-label={ui.x.common.prev}><Icon name="arrow" /></button>
          <button class="round" type="button" data-next aria-label={ui.x.common.next}><Icon name="arrow" /></button>
        </div>
      </div>
    </div>
    <div class="wrap center more-row">
      <a class="btn light" href={L('/blog/')}>{ui.blog.all}</a>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: max(680px, 100svh);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: var(--white);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: zoom 16s var(--ease) both;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(5, 12, 26, 0.86) 0%, rgba(5, 12, 26, 0.55) 48%, rgba(5, 12, 26, 0.15) 100%),
      linear-gradient(180deg, rgba(5, 12, 26, 0.35) 0%, rgba(5, 12, 26, 0) 30%, rgba(5, 12, 26, 0.55) 100%);
  }
  .hero-in {
    position: relative;
    z-index: 1;
    padding-top: calc(var(--head-h) + 80px);
    padding-bottom: clamp(48px, 7vw, 96px);
  }
  .hero-kicker {
    font-family: var(--font-ui);
    font-weight: 500;
    color: var(--gold-2);
    margin-bottom: 18px;
  }
  html[lang='mr'] .hero-kicker {
    font-family: var(--font-body);
    font-weight: 700;
  }
  .hero h1 {
    color: var(--white);
    margin: 0 0 26px;
    max-width: 15ch;
  }
  html[lang='mr'] .hero h1 {
    max-width: 20ch;
  }
  .hero h1 .big {
    display: block;
  }
  .hero h1 .accent {
    color: var(--gold-2);
  }
  .hero h1 .small {
    display: block;
    margin-top: 14px;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: clamp(1.25rem, 2.4vw, 2rem);
    line-height: 1.2;
    text-transform: none;
    letter-spacing: -0.01em;
    color: var(--on-dark);
  }
  html[lang='mr'] .hero h1 .small {
    font-family: var(--font-body);
    font-weight: 700;
  }
  .hero-lede {
    max-width: 56ch;
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    color: var(--on-dark);
    margin-bottom: 30px;
  }
  .facts {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    font-size: 0.95rem;
    color: var(--on-dark-muted);
  }
  .facts li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .facts :global(svg) {
    color: var(--gold-2);
  }

  /* Moving words */
  .words {
    padding-block: clamp(48px, 7vw, 96px);
    display: grid;
    gap: clamp(6px, 1vw, 14px);
    overflow: hidden;
  }
  .word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(4.4rem, 11vw, 10.5rem);
    line-height: 0.95;
    text-transform: uppercase;
  }
  html[lang='mr'] .word {
    text-transform: none;
    font-size: clamp(3.6rem, 9vw, 8.4rem);
    line-height: 1.25;
  }
  .wchip {
    flex: none;
    width: clamp(70px, 9vw, 140px);
    height: clamp(70px, 9vw, 140px);
    border-radius: clamp(14px, 1.8vw, 26px);
    overflow: hidden;
    background: var(--sand-2);
  }
  .wchip :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Find your platform */
  .find .head {
    margin-inline: auto;
    max-width: 1100px;
  }
  .find .tabs {
    justify-content: center;
  }
  @media (max-width: 640px) {
    .find .tabs {
      justify-content: flex-start;
    }
  }
  .find .intro {
    margin-bottom: 34px;
  }
  .center-snap {
    --cw: min(80vw, 760px);
  }
  .center-snap .track {
    padding-inline: calc((100vw - var(--cw)) / 2);
    scroll-padding-inline: calc((100vw - var(--cw)) / 2);
  }
  .center-snap .track > * {
    scroll-snap-align: center;
  }
  .pcard {
    display: grid;
    gap: 22px;
    transition: opacity 0.4s, transform 0.5s var(--ease);
    opacity: 0.42;
    transform: scale(0.9);
  }
  .pcard.is-active {
    opacity: 1;
    transform: none;
  }
  .pcard-visual {
    display: block;
  }
  .pcard-text {
    text-align: center;
    max-width: 52ch;
    margin-inline: auto;
  }
  .pcard h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    line-height: 1;
    text-transform: uppercase;
    margin: 6px 0 10px;
  }
  html[lang='mr'] .pcard h3 {
    text-transform: none;
    line-height: 1.2;
  }
  .pcard h3 a {
    color: var(--navy);
    text-decoration: none;
  }
  .pcard h3 a:hover {
    color: var(--royal);
  }
  .pcard-text p:last-child {
    color: var(--muted);
    font-size: 1.08rem;
  }
  .more-row {
    margin-top: clamp(36px, 5vw, 56px);
  }

  /* Services bento */
  .split {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 32px 64px;
    align-items: end;
    max-width: none;
  }
  .split h2 {
    margin: 0;
  }
  .services .split p {
    color: var(--on-dark-muted);
  }
  .bento {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: minmax(260px, 22vw);
    gap: 18px;
  }
  .bento .b0 {
    grid-column: span 2;
    grid-row: span 2;
  }
  .bento .b3,
  .bento .b4,
  .bento .b5 {
    grid-column: span 2;
  }
  .bento a {
    position: relative;
    display: block;
    height: 100%;
    border-radius: var(--r-lg);
    overflow: hidden;
    color: var(--white);
    text-decoration: none;
    background: var(--navy);
  }
  .bento :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }
  .bento a:hover :global(img) {
    transform: scale(1.06);
  }
  .b-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(5, 12, 26, 0.05) 30%, rgba(5, 12, 26, 0.85) 100%);
  }
  .b-icon {
    position: absolute;
    top: 18px;
    left: 18px;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: var(--white);
    color: var(--royal);
    box-shadow: 0 10px 24px -12px rgba(5, 12, 26, 0.6);
    z-index: 1;
  }
  .b-text {
    position: absolute;
    left: 22px;
    right: 22px;
    bottom: 20px;
    display: grid;
    gap: 6px;
  }
  .b-text h3 {
    color: var(--white);
    margin: 0;
    font-size: 1.3rem;
  }
  .b0 .b-text h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.2rem, 3.6vw, 3.4rem);
    line-height: 0.95;
    text-transform: uppercase;
  }
  html[lang='mr'] .b0 .b-text h3 {
    text-transform: none;
    line-height: 1.2;
  }
  .b-sum {
    color: var(--on-dark);
    font-size: 0.98rem;
    line-height: 1.45;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.4s var(--ease), opacity 0.3s;
  }
  .b0 .b-sum,
  .bento a:hover .b-sum,
  .bento a:focus-visible .b-sum {
    max-height: 6em;
    opacity: 1;
  }
  .more-services {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
  .more-services a:not(.btn) {
    font-size: 0.95rem;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--line-dark);
    color: var(--on-dark);
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }
  .more-services a:not(.btn):hover {
    border-color: var(--gold-2);
    color: var(--gold-2);
  }
  .more-services .btn {
    margin-left: auto;
  }

  /* Built for Maharashtra */
  .state {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    background: var(--navy);
    min-height: min(92vh, 860px);
  }
  .state-photo {
    position: relative;
    background: var(--navy-2);
    padding: clamp(32px, 4vw, 56px) 0 0 0;
  }
  .state-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-top-right-radius: 100% 58%;
  }
  .state-text {
    padding: clamp(56px, 8vw, 110px) clamp(28px, 5vw, 80px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    color: var(--on-dark);
  }
  .state-text h2 {
    color: var(--white);
  }
  .state-text p {
    color: var(--on-dark);
    font-size: 1.15rem;
    max-width: 50ch;
