---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../data/site';
import { t } from '../i18n/ui';
import { localize, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  kind: 'privacy' | 'terms';
}
const { lang, kind } = Astro.props;
const ui = t(lang);
const L = (p: string) => localize(p, lang);
const title = kind === 'privacy' ? ui.legal.privacy : ui.legal.terms;
const desc =
  kind === 'privacy'
    ? 'How Kingmaker Enterprises handles personal data on this website and in the systems it builds.'
    : 'Terms for using the Kingmaker Enterprises website and general terms for our software and digital services.';
---

<Base lang={lang} title={title} description={desc}>
  <PageHead lang={lang} title={title} crumbs={[{ label: title, href: L(`/${kind}/`) }]} intro={ui.legal.updated} />
  <section class="section">
    <div class="wrap prose">
      {lang === 'mr' && <p class="note">{ui.legal.mrNote}</p>}
      <div lang="en">
        {
          kind === 'privacy' ? (
            <>
              <h2>Who we are</h2>
              <p>
                This website is operated by {site.name}, a proprietorship registered in Maharashtra, India (Udyam {site.udyam}, GSTIN {site.gstin}), at {site.address}. You can reach us at {site.email} or {site.phoneDisplay}.
              </p>

              <h2>What this website collects</h2>
              <p>
                This website does not use cookies, analytics trackers or advertising pixels. It does not store any form data. The contact form prepares a message and opens it in your own WhatsApp or email application; the message is sent by you, from your account, and reaches us as an ordinary WhatsApp message or email.
              </p>
              <p>
                Our web host may record standard server logs such as IP address, browser type and pages requested for security and operational purposes, under the host's own privacy policy.
              </p>

              <h2>Messages you send us</h2>
              <p>
                When you contact us on WhatsApp, by phone or by email, we keep your name, contact details and the content of the conversation for as long as needed to respond, prepare a proposal and provide services. We do not sell or share this information with anyone outside the firm, except service providers we need to deliver the work (for example a hosting provider) under confidentiality.
              </p>

              <h2>Data in systems we build for clients</h2>
              <p>
                Software we build for government departments, hospitals, political organisations and businesses processes personal data on behalf of that client. In those systems the client is the data fiduciary under the Digital Personal Data Protection Act, 2023, and we act on the client's written instructions. We design these systems with role-based access, access logs, data stored in India and retention rules agreed with the client, and we do not use client data for any other purpose.
              </p>

              <h2>Your rights</h2>
              <p>
                You can ask us what personal data we hold about you, ask for it to be corrected or deleted, or withdraw consent for future contact, by writing to {site.email}. We respond within 30 days. If you are a user of a system we built for one of our clients, please contact that organisation first; we will assist them with your request.
              </p>

              <h2>Changes</h2>
              <p>We update this page when our practices change. The date at the top shows the latest revision.</p>
            </>
          ) : (
            <>
              <h2>Using this website</h2>
              <p>
                The content of this website is provided by {site.name} for general information about our services and products. Product descriptions, screens and figures shown are illustrations and may differ from the system delivered for a specific client. We may change the content at any time.
              </p>

              <h2>Intellectual property</h2>
              <p>
                The Kingmaker Enterprises name, logo, text and illustrations on this site belong to {site.name}. Client names and product names mentioned belong to their respective owners. You may link to this site, but may not copy its content for commercial use without written permission.
              </p>

              <h2>Engagements</h2>
              <p>
                Every project is governed by a written proposal, quotation or work order that sets out scope, price, timeline, hosting, data protection and support terms. Those documents take precedence over this page. Unless the proposal says otherwise: demos and pilots offered at no cost remain our property until a purchase is made; on full payment the client receives the source code and data of the delivered system; and maintenance, hosting and third-party costs are charged as stated in the proposal.
              </p>

              <h2>Government procurement</h2>
              <p>
                Supplies to government departments and public bodies are made under the terms of the relevant purchase order, GeM contract or tender conditions, which govern over these general terms.
              </p>

              <h2>Limitation</h2>
              <p>
                We take care to keep this website accurate and available, but we do not guarantee uninterrupted access and are not liable for losses arising from reliance on general information published here. Liability under a project is as set out in that project's agreement.
              </p>

              <h2>Jurisdiction</h2>
              <p>These terms are governed by the laws of India. Courts at Parbhani, Maharashtra, have jurisdiction over any dispute relating to this website.</p>

              <h2>Contact</h2>
              <p>
                {site.name}, {site.address}. Email {site.email}, phone {site.phoneDisplay}.
              </p>
            </>
          )
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .note {
    padding: 16px 20px;
    border-left: 3px solid var(--gold);
    background: var(--paper);
    border-radius: 0 var(--r) var(--r) 0;
    color: var(--navy);
    font-size: 1rem;
  }
  .prose > div > h2:first-child {
    margin-top: 1.2em;
  }
</style>
