---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { site } from '../data/site';
import { photos, px, type PhotoKey } from '../data/images';
import { t } from '../i18n/ui';
import { localize, byLang, isPublished, entrySlug, fmtDate, fmtDateShort, otherLang, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  post: CollectionEntry<'blog'>;
}
const { lang, post } = Astro.props;
const ui = t(lang);
const xc = ui.x.common;
const L = (p: string) => localize(p, lang);
const { Content } = await render(post);
const all = await getCollection('blog', isPublished);
const slug = entrySlug(post.id);
const other = otherLang(lang);
const hasAlt = all.some((p) => p.id === `${other}/${slug}`);
const altPath = hasAlt ? localize(`/blog/${slug}/`, other) : localize('/blog/', other);
// Related: shared tags, plus posts that point readers to the same product or service page.
const tags = new Set(post.data.tags);
const pageLinks = (post.body ?? '').match(/\/(products|services)\/[a-z0-9-]+\//g) ?? [];
const score = (p: CollectionEntry<'blog'>) =>
  p.data.tags.filter((tag) => tags.has(tag)).length + pageLinks.filter((l) => (p.body ?? '').includes(l)).length;
const more = byLang(all, lang)
  .filter((p) => p.id !== post.id)
  .map((p) => ({ p, s: score(p) }))
  .sort((a, b) => b.s - a.s || b.p.data.date.valueOf() - a.p.data.date.valueOf())
  .slice(0, 6)
  .map((x) => x.p);

const url = new URL(L(`/blog/${slug}/`), site.url).toString();
const enc = encodeURIComponent;
const shares = [
  { name: 'linkedin', label: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}` },
  { name: 'xsocial', label: 'X', href: `https://twitter.com/intent/tweet?url=${enc(url)}&text=${enc(post.data.title)}` },
  { name: 'facebook', label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}` },
  { name: 'whatsapp', label: 'WhatsApp', href: `https://wa.me/?text=${enc(`${post.data.title} ${url}`)}` },
];

const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  inLanguage: lang,
  image: px(photos[post.data.cover as PhotoKey].id, 1200, 630),
  keywords: post.data.tags.join(', '),
  author: { '@type': 'Organization', name: post.data.author, url: site.url },
  publisher: { '@id': `${site.url}/#organization` },
  mainEntityOfPage: url,
};
const crumbs = [
  { label: ui.nav.home, href: L('/') },
  { label: ui.nav.blog, href: L('/blog/') },
  { label: post.data.title, href: L(`/blog/${slug}/`) },
];
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, item: new URL(c.href, site.url).toString() })),
};
---

<Base lang={lang} title={post.data.title} description={post.data.description} type="article" publishedTime={post.data.date.toISOString()} hasAlt={hasAlt} altPath={altPath}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(article)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

  <header class="art-head">
    <div class="wrap narrow">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          {
            crumbs.slice(0, 2).map((c) => (
              <li>
                <a href={c.href}>{c.label}</a>
              </li>
            ))
          }
        </ol>
      </nav>
      <p class="kicker">{post.data.tags[0]}</p>
      <h1 class="art-title">{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      <div class="byline">
        <p class="meta">
          <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date, lang)}</time>
          <span>{post.data.readingMinutes} {ui.blog.minRead}</span>
          <span>{post.data.author}</span>
        </p>
        <div class="share" aria-label={xc.share}>
          <button class="sh" type="button" data-copy={url} data-done={xc.copied} aria-label={xc.copyLink}>
            <Icon name="link" size={18} />
          </button>
          {
            shares.map((s) => (
              <a class="sh" href={s.href} target="_blank" rel="noopener" aria-label={`${xc.share}: ${s.label}`}>
                <Icon name={s.name} size={18} />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </header>

  <div class="wrap cover-wrap">
    <Photo name={post.data.cover} w={1400} h={700} class="cover" eager sizes="(max-width: 1240px) 100vw, 1240px" />
  </div>

  <article class="section tight">
    <div class="wrap narrow">
      <div class="prose">
        <Content />
      </div>
      <div class="foot">
        <ul class="tags">
          {post.data.tags.map((tg) => <li>{tg}</li>)}
        </ul>
        <div class="share">
          <span class="share-label">{xc.share}</span>
          <button class="sh" type="button" data-copy={url} data-done={xc.copied} aria-label={xc.copyLink}>
            <Icon name="link" size={18} />
          </button>
          {
            shares.map((s) => (
              <a class="sh" href={s.href} target="_blank" rel="noopener" aria-label={`${xc.share}: ${s.label}`}>
                <Icon name={s.name} size={18} />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </article>

  {
    more.length > 0 && (
      <section class="section sand related">
        <div class="wrap rel-head">
          <h2 class="d-md">{ui.blog.related}</h2>
          <a class="btn navy" href={L('/blog/')}>
            {ui.blog.all}
          </a>
        </div>
        <div class="carousel" data-carousel data-slide-label={xc.slide} style="--cw: min(82%, 400px)">
          <ul class="track" tabindex="0">
            {more.map((p) => (
              <li>
                <a class="photo-card" href={L(`/blog/${entrySlug(p.id)}/`)}>
                  <span class="ph">
                    <Photo name={p.data.cover} w={640} h={420} sizes="(max-width: 640px) 82vw, 400px" />
                    <span class="chip">{p.data.tags[0]}</span>
                  </span>
                  <h3>{p.data.title}</h3>
                  <time class="when" datetime={p.data.date.toISOString()}>
                    {fmtDateShort(p.data.date, lang)}
                  </time>
                </a>
              </li>
            ))}
          </ul>
          <div class="wrap car-foot">
            <div class="dots" data-dots />
            <div class="arrows">
              <button class="round prev" type="button" data-prev aria-label={xc.prev}>
                <Icon name="arrow" />
              </button>
              <button class="round" type="button" data-next aria-label={xc.next}>
                <Icon name="arrow" />
              </button>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <CtaBand lang={lang} />
</Base>

<style>
  .narrow {
    max-width: 820px;
  }
  .art-head {
    background: var(--sand);
    padding: calc(var(--head-h) + clamp(56px, 8vw, 104px)) 0 clamp(120px, 14vw, 200px);
  }
  .crumbs ol {
    list-style: none;
    margin: 0 0 26px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 0.9rem;
  }
  .crumbs li + li::before {
    content: '/';
    color: var(--muted);
    margin-right: 6px;
  }
  .crumbs a {
    color: var(--muted);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--royal);
  }
  .kicker {
    margin-bottom: 14px;
  }
  .art-title {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: none;
    font-size: clamp(2.4rem, 5.2vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -0.005em;
    color: var(--navy);
    margin: 0 0 22px;
  }
  html[lang='mr'] .art-title {
    line-height: 1.22;
    font-size: clamp(2.1rem, 4.4vw, 3.5rem);
  }
  .lead {
    font-size: clamp(1.15rem, 1.7vw, 1.35rem);
    color: var(--text);
    margin: 0;
  }
  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    margin-top: 32px;
    padding-top: 22px;
    border-top: 1px solid rgba(15, 39, 71, 0.14);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .share {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .share-label {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--navy);
    margin-right: 4px;
  }
  .sh {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: inline-grid;
    place-items: center;
    border: 0;
    background: var(--white);
    color: var(--navy);
    cursor: pointer;
    transition: background 0.2s, color 0.2s, transform 0.2s var(--ease);
  }
  .sh:hover {
    background: var(--navy);
    color: var(--white);
    transform: translateY(-2px);
  }
  .sh.done {
    background: var(--gold);
    color: var(--ink);
  }
  .cover-wrap {
    margin-top: calc(-1 * clamp(80px, 11vw, 160px));
  }
  .cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    border-radius: var(--r-xl);
    background: var(--navy-2);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .foot .sh {
    background: var(--sand);
  }
  .foot .sh:hover {
    background: var(--navy);
  }
  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tags li {
    font-size: 0.85rem;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--sky-2);
    color: var(--navy);
    font-weight: 500;
  }
  .rel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  .rel-head h2 {
    margin: 0;
  }
  .related .ph :global(img) {
    aspect-ratio: 640 / 420;
  }
  .related h3 {
    font-size: 1.15rem;
  }
  .when {
    font-size: 0.86rem;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .cover {
      aspect-ratio: 4 / 3;
      border-radius: var(--r-lg);
    }
  }
</style>
