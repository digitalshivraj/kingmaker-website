---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import PhotoMock from '../components/PhotoMock.astro';
import CtaBand from '../components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { projects, sectors, sectorNames } from '../data/portfolio';
import { whatsappLink } from '../data/site';
import { t } from '../i18n/ui';
import { localize, byLang, entrySlug, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const L = (p: string) => localize(p, lang);
const products = byLang(await getCollection('products'), lang).sort((a, b) => a.data.order - b.data.order);
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const projName = (p: (typeof projects)[number]) => (lang === 'mr' && p.marathi ? p.marathi : p.name);
---

<Base lang={lang} title={ui.productsPage.title} description={ui.productsPage.desc(products.length, projects.length)}>
  <PageHead
    lang={lang}
    title={ui.productsPage.title}
    marathi={ui.productsPage.sub}
    intro={ui.productsPage.intro(products.length, projects.length)}
    crumbs={[{ label: ui.nav.products, href: L('/products/') }]}
  >
    <nav class="jump" aria-label="Sectors">
      {sectors.map((s) => <a href={`#${slug(s)}`}>{sectorNames[s][lang]}</a>)}
    </nav>
  </PageHead>

  <section class="section">
    <div class="wrap">
      <div class="head" data-reveal>
        <h2>{ui.productsPage.readyH2}</h2>
        <p>{ui.productsPage.readyP}</p>
      </div>
      <div class="flag-grid">
        {
          products.map((p, i) => {
            const href = L(`/products/${entrySlug(p.id)}/`);
            return (
              <article class="flag" data-reveal style={`--rd: ${(i % 2) * 0.08}s`}>
                <a href={href} class="vis" aria-label={p.data.title}>
                  <PhotoMock photo={p.data.photo} variant={p.data.mock} title={p.data.title} lang={lang} />
                </a>
                <h3>
                  <a href={href}>{p.data.title}</a>
                </h3>
                <p>{p.data.tagline}</p>
                <span class="status">{p.data.status}</span>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section paper">
    <div class="wrap">
      <div class="head" data-reveal>
        <h2>{ui.productsPage.allH2}</h2>
        <p>{ui.productsPage.allP}</p>
      </div>
      {
        sectors.map((sec) => {
          const list = projects.filter((p) => p.sector === sec);
          return (
            <div class="sector" id={slug(sec)}>
              <h3>{sectorNames[sec][lang]}</h3>
              <ul>
                {list.map((p) => (
                  <li data-reveal>
                    <div class="name">
                      <b>{p.product ? <a href={L(`/products/${p.product}/`)}>{projName(p)}</a> : projName(p)}</b>
                    </div>
                    <p>{lang === 'mr' ? p.summaryMr : p.summary}</p>
                    <div class="meta">
                      <span class={`st ${slug(p.status)}`}>{ui.common.status[p.status]}</span>
                      {p.stack && <span class="stack">{p.stack}</span>}
                      <a href={whatsappLink(ui.productsPage.askMsg(p.name))} target="_blank" rel="noopener">
                        {ui.productsPage.ask}
                      </a>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>
  </section>

  <CtaBand lang={lang} title={ui.productsPage.ctaTitle} text={ui.productsPage.ctaText} message={ui.productsPage.ctaMsg} />
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }
  .jump a {
    font-size: 0.88rem;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: var(--on-dark);
    text-decoration: none;
  }
  .jump a:hover {
    border-color: var(--gold-2);
    color: var(--gold-2);
  }
  .flag-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px 48px;
  }
  .flag .vis {
    display: block;
    margin-bottom: 18px;
    text-decoration: none;
    color: inherit;
  }
  .sub {
    color: var(--gold-3);
    margin-bottom: 2px;
  }
  .flag h3 {
    font-size: 1.4rem;
    margin-bottom: 4px;
  }
  .flag h3 a {
    color: var(--navy);
    text-decoration: none;
  }
  .flag h3 a:hover {
    color: var(--gold-3);
  }
  .flag p {
    color: var(--muted);
  }
  .status {
    display: inline-block;
    margin-top: 10px;
    font-size: 0.85rem;
    color: var(--navy);
    background: var(--paper-2);
    padding: 4px 12px;
    border-radius: 999px;
  }
  .sector {
    padding-top: 28px;
    margin-top: 28px;
    border-top: 2px solid var(--line);
    scroll-margin-top: 90px;
  }
  .sector h3 {
    font-size: 1.35rem;
    margin-bottom: 18px;
  }
  .sector ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .sector li {
    display: grid;
    gap: 6px;
    align-content: start;
    padding: 18px 20px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r);
  }
  .name {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    align-items: baseline;
  }
  .name b {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--navy);
    font-size: 1.05rem;
  }
  html[lang='mr'] .name b {
    font-family: var(--font-body);
    font-weight: 700;
  }
  .name a {
    color: var(--navy);
    text-decoration: none;
  }
  .name a:hover {
    color: var(--gold-3);
  }
  .name .marathi {
    color: var(--gold-3);
    font-size: 0.95rem;
  }
  .sector p {
    color: var(--muted);
    font-size: 0.98rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    align-items: center;
    font-size: 0.85rem;
  }
  .st {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--paper-2);
    color: var(--navy);
  }
  .st.live {
    background: #dff3e7;
    color: #1f6b43;
  }
  .st.pilot,
  .st.demo-ready {
    background: #e3ecf8;
    color: #1f467c;
  }
  .st.in-build {
    background: #fbefd6;
    color: #7a5410;
  }
  .stack {
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .flag-grid,
    .sector ul {
      grid-template-columns: 1fr;
    }
  }
</style>
