---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { site } from '../data/site';
import { t } from '../i18n/ui';
import { localize, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const c = ui.contact;
const L = (p: string) => localize(p, lang);
---

<Base lang={lang} title={c.title} description={c.desc}>
  <PageHead lang={lang} title={c.title} variant="pattern" intro={c.intro} crumbs={[{ label: ui.nav.contact, href: L('/contact/') }]} />

  <section class="section tight">
    <div class="wrap two">
      <div class="ways" data-reveal>
        <h2 class="d-md">{ui.x.contact.big}</h2>
        <ul class="rule-list">
          <li>
            <p class="label">{c.waSub}</p>
            <h3><a href={site.whatsapp} target="_blank" rel="noopener">{lang === 'mr' ? 'व्हॉट्सॲप' : 'WhatsApp'} {site.phoneDisplay}</a></h3>
            <a class="arrow-link" href={site.whatsapp} target="_blank" rel="noopener">{ui.x.prefooter.wa}<Icon name="arrow" size={18} /></a>
          </li>
          <li>
            <p class="label">{ui.common.hours}</p>
            <h3><a href={`tel:${site.phoneIntl}`}>{site.phoneDisplay}</a></h3>
          </li>
          <li>
            <p class="label">{c.mailSub}</p>
            <h3><a href={`mailto:${site.email}`}>{site.email}</a></h3>
          </li>
          <li>
            <p class="label">{c.meetings}</p>
            <h3>{lang === 'mr' ? site.addressMarathi : site.address}</h3>
            <p class="muted">{c.meetingsP}</p>
          </li>
        </ul>
      </div>

      <form
        id="contact-form"
        class="form"
        novalidate
        data-greeting={c.greeting('{name}')}
        data-org={c.fOrg}
        data-mobile={c.fMobile}
        data-need={c.fNeed}
        data-msg={c.fMsg}
        data-subject={c.subject}
        data-reveal
        style="--rd: 0.1s"
      >
        <h2 class="d-sm">{c.formH2}</h2>
        <div class="row">
          <label for="name">{c.name}</label>
          <input id="name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="row">
          <label for="org">{c.org}</label>
          <input id="org" name="org" type="text" autocomplete="organization" placeholder={c.orgPh} />
        </div>
        <div class="row">
          <label for="phone">{c.phone}</label>
          <input id="phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel" />
        </div>
        <div class="row">
          <label for="need">{c.need}</label>
          <select id="need" name="need">
            {c.needs.map((n) => <option>{n}</option>)}
          </select>
        </div>
        <div class="row">
          <label for="msg">{c.msg}</label>
          <textarea id="msg" name="msg" rows="5" placeholder={c.msgPh}></textarea>
        </div>
        <p class="err" id="form-err" hidden>{c.err}</p>
        <div class="actions">
          <button class="btn gold" type="submit">
            <Icon name="whatsapp" />
            <span>{c.sendWa}</span>
          </button>
          <button class="btn ghost" type="button" id="mail-btn">
            <Icon name="mail" />
            <span>{c.sendMail}</span>
          </button>
        </div>
        <p class="note">{c.note}</p>
      </form>
    </div>
  </section>

  <section class="band">
    <Photo name="road" w={1800} h={760} sizes="100vw" class="band-photo" />
    <div class="band-shade"></div>
    <div class="wrap band-text">
      <h2 class="display d-md" data-reveal>{ui.x.home.stateBig[0]} <span class="accent">{ui.x.home.stateBig[1]}</span></h2>
      <p data-reveal>{ui.x.home.stateText}</p>
    </div>
  </section>
</Base>

<style>
  .two {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }
  .ways h2 {
    margin-bottom: 32px;
  }
  .ways h3 {
    font-size: clamp(1.3rem, 2vw, 1.6rem);
    margin: 4px 0 6px;
    overflow-wrap: anywhere;
  }
  .ways h3 a {
    color: var(--navy);
    text-decoration: none;
  }
  .ways h3 a:hover {
    color: var(--royal);
  }
  .muted {
    color: var(--muted);
  }
  .form {
    background: var(--sand);
    border-radius: var(--r-xl);
    padding: clamp(24px, 4vw, 44px);
    display: grid;
    gap: 16px;
  }
  .form h2 {
    margin-bottom: 8px;
  }
  .row {
    display: grid;
    gap: 6px;
  }
  label {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--navy);
  }
  html[lang='mr'] label {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
  }
  input,
  select,
  textarea {
    font: inherit;
    padding: 14px 16px;
    border-radius: 14px;
    border: 1.5px solid transparent;
    background: var(--white);
    color: var(--text);
    width: 100%;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--royal);
    box-shadow: 0 0 0 4px rgba(36, 71, 124, 0.12);
  }
  .err {
    color: #b42318;
    font-weight: 600;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 4px;
  }
  .note {
    font-size: 0.9rem;
    color: var(--muted);
  }
  .band {
    position: relative;
    min-height: 460px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    margin-top: clamp(40px, 6vw, 80px);
  }
  .band-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .band-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(5, 12, 26, 0.05) 20%, rgba(5, 12, 26, 0.75) 100%);
  }
  .band-text {
    position: relative;
    z-index: 1;
    padding-block: 56px;
    color: var(--white);
    max-width: 900px;
    margin-inline: auto;
    text-align: center;
  }
  .band-text .d-md {
    color: var(--white);
    margin-bottom: 18px;
  }
  .band-text .accent {
    color: var(--gold-2);
  }
  .band-text p:last-child {
    color: var(--on-dark);
    font-size: 1.12rem;
  }
  @media (max-width: 900px) {
    .two {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .ways h3 {
      font-size: 1.1rem;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const err = document.getElementById('form-err') as HTMLElement;
  const d = form.dataset;
  const field = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement).value.trim();

  function compose() {
    const name = field('name');
    if (!name) {
      err.hidden = false;
      (document.getElementById('name') as HTMLInputElement).focus();
      return null;
    }
    err.hidden = true;
    const lines = [
      (d.greeting || 'Hello Kingmaker Enterprises, I am {name}.').replace('{name}', name),
      field('org') && `${d.org}: ${field('org')}`,
      field('phone') && `${d.mobile}: ${field('phone')}`,
      `${d.need}: ${field('need')}`,
      field('msg') && `${d.msg}: ${field('msg')}`,
    ].filter(Boolean);
    return lines.join('\n');
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const text = compose();
    if (!text) return;
    window.open(`https://wa.me/919975158770?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
  });

  document.getElementById('mail-btn')?.addEventListener('click', () => {
    const text = compose();
    if (!text) return;
    const subject = `${d.subject}: ${field('need')}`;
    window.location.href = `mailto:contact@kingmakerenterprises.in?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(text)}`;
  });
</script>
