---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { site } from '../data/site';
import { t } from '../i18n/ui';
import { localize, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const c = ui.contact;
const L = (p: string) => localize(p, lang);
---

<Base lang={lang} title={c.title} description={c.desc}>
  <PageHead lang={lang} title={c.title} marathi={c.sub} intro={c.intro} crumbs={[{ label: ui.nav.contact, href: L('/contact/') }]} />

  <section class="section">
    <div class="wrap two">
      <form
        id="contact-form"
        class="form"
        novalidate
        data-greeting={c.greeting('{name}')}
        data-org={c.fOrg}
        data-mobile={c.fMobile}
        data-need={c.fNeed}
        data-msg={c.fMsg}
        data-subject={c.subject}
        data-reveal
      >
        <h2>{c.formH2}</h2>
        <div class="row">
          <label for="name">{c.name}</label>
          <input id="name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="row">
          <label for="org">{c.org}</label>
          <input id="org" name="org" type="text" autocomplete="organization" placeholder={c.orgPh} />
        </div>
        <div class="row">
          <label for="phone">{c.phone}</label>
          <input id="phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel" />
        </div>
        <div class="row">
          <label for="need">{c.need}</label>
          <select id="need" name="need">
            {c.needs.map((n) => <option>{n}</option>)}
          </select>
        </div>
        <div class="row">
          <label for="msg">{c.msg}</label>
          <textarea id="msg" name="msg" rows="5" placeholder={c.msgPh}></textarea>
        </div>
        <p class="err" id="form-err" hidden>{c.err}</p>
        <div class="actions">
          <button class="btn gold" type="submit">
            <Icon name="whatsapp" />
            <span>{c.sendWa}</span>
          </button>
          <button class="btn ghost" type="button" id="mail-btn">
            <Icon name="mail" />
            <span>{c.sendMail}</span>
          </button>
        </div>
        <p class="note">{c.note}</p>
      </form>

      <aside data-reveal style="--rd: 0.1s">
        <Photo name="road" w={700} h={400} class="aside-photo" sizes="(max-width: 860px) 100vw, 40vw" />
        <div class="card">
          <h3>{c.direct}</h3>
          <ul>
            <li>
              <Icon name="whatsapp" size={20} />
              <div>
                <a href={site.whatsapp} target="_blank" rel="noopener">{site.phoneDisplay}</a>
                <span>{c.waSub}</span>
              </div>
            </li>
            <li>
              <Icon name="phone" size={20} />
              <div>
                <a href={`tel:${site.phoneIntl}`}>{site.phoneDisplay}</a>
                <span>{ui.common.hours}</span>
              </div>
            </li>
            <li>
              <Icon name="mail" size={20} />
              <div>
                <a href={`mailto:${site.email}`}>{site.email}</a>
                <span>{c.mailSub}</span>
              </div>
            </li>
            <li>
              <Icon name="pin" size={20} />
              <div>
                <span class="addr">{lang === 'mr' ? site.addressMarathi : site.address}</span>
                <span class="marathi">{lang === 'mr' ? site.address : site.addressMarathi}</span>
              </div>
            </li>
          </ul>
        </div>
        <div class="card">
          <h3>{c.meetings}</h3>
          <p>{c.meetingsP}</p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .two {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: start;
  }
  .form {
    display: grid;
    gap: 18px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--white);
    box-shadow: var(--shadow);
  }
  .form h2 {
    margin-bottom: 4px;
  }
  .row {
    display: grid;
    gap: 6px;
  }
  label {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--navy);
  }
  html[lang='mr'] label {
    font-family: var(--font-body);
    font-weight: 600;
  }
  input,
  select,
  textarea {
    font: inherit;
    padding: 12px 14px;
    border: 1.5px solid var(--line);
    border-radius: 10px;
    background: var(--white);
    color: var(--text);
    min-height: 48px;
  }
  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--navy);
    outline: 3px solid rgba(201, 149, 46, 0.35);
    outline-offset: 0;
  }
  textarea {
    resize: vertical;
  }
  .err {
    color: #a3341d;
    font-weight: 500;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .note {
    font-size: 0.9rem;
    color: var(--muted);
  }
  aside {
    display: grid;
    gap: 20px;
  }
  .aside-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 700 / 400;
    object-fit: cover;
    border-radius: var(--r-lg);
  }
  .card {
    background: var(--paper);
    border-radius: var(--r-lg);
    padding: 26px;
  }
  .card h3 {
    margin-bottom: 14px;
  }
  .card p {
    color: var(--muted);
  }
  .card ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .card li {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 12px;
    align-items: start;
  }
  .card svg {
    color: var(--gold-3);
    margin-top: 5px;
  }
  .card li div {
    display: grid;
    gap: 2px;
  }
  .card li a {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--navy);
    text-decoration: none;
  }
  .card li a:hover {
    color: var(--gold-3);
  }
  .card li span {
    font-size: 0.92rem;
    color: var(--muted);
  }
  .addr {
    color: var(--text) !important;
    font-size: 1rem !important;
  }
  @media (max-width: 860px) {
    .two {
      grid-template-columns: 1fr;
    }
    .form {
      padding: 20px;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const err = document.getElementById('form-err') as HTMLElement;
  const d = form.dataset;
  const field = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement).value.trim();

  function compose() {
    const name = field('name');
    if (!name) {
      err.hidden = false;
      (document.getElementById('name') as HTMLInputElement).focus();
      return null;
    }
    err.hidden = true;
    const lines = [
      (d.greeting || 'Hello Kingmaker Enterprises, I am {name}.').replace('{name}', name),
      field('org') && `${d.org}: ${field('org')}`,
      field('phone') && `${d.mobile}: ${field('phone')}`,
      `${d.need}: ${field('need')}`,
      field('msg') && `${d.msg}: ${field('msg')}`,
    ].filter(Boolean);
    return lines.join('\n');
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const text = compose();
    if (!text) return;
    window.open(`https://wa.me/919975158770?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
  });

  document.getElementById('mail-btn')?.addEventListener('click', () => {
    const text = compose();
    if (!text) return;
    const subject = `${d.subject}: ${field('need')}`;
    window.location.href = `mailto:contact@kingmakerenterprises.in?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(text)}`;
  });
</script>
