---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';
import { site } from '../data/site';
import { projects } from '../data/portfolio';
import { t } from '../i18n/ui';
import { localize, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const a = ui.about;
const L = (p: string) => localize(p, lang);
const live = projects.filter((p) => p.status === 'Live').length;
const facts = [
  [String(site.since), a.facts[0]],
  [String(projects.length), a.facts[1]],
  ['9', a.facts[2]],
  ['2', a.facts[3]],
];
---

<Base lang={lang} title={ui.nav.about} description={a.desc}>
  <PageHead lang={lang} title={a.title} marathi={a.sub} intro={a.intro} crumbs={[{ label: ui.nav.about, href: L('/about/') }]} photo="team" />

  <section class="section tight">
    <div class="wrap strip">
      <Photo name="policeTeam" w={600} h={420} sizes="(max-width: 760px) 50vw, 25vw" data-reveal />
      <Photo name="villageMeeting" w={600} h={420} sizes="(max-width: 760px) 50vw, 25vw" data-reveal style="--rd: 0.08s" />
      <Photo name="doctorHall" w={600} h={420} sizes="(max-width: 760px) 50vw, 25vw" data-reveal style="--rd: 0.16s" />
      <Photo name="farmerRoad" w={600} h={420} sizes="(max-width: 760px) 50vw, 25vw" data-reveal style="--rd: 0.24s" />
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div class="prose" data-reveal>
        <h2>{a.h1}</h2>
        <p>{a.p1a}</p>
        <p>{a.p1b}</p>
        <h2>{a.h2}</h2>
        <p>{a.p2a(ui.common.proprietor, live)}</p>
        <p>{a.p2b}</p>
        <h2>{a.h3}</h2>
        <p>{a.p3}</p>
      </div>
      <aside data-reveal style="--rd: 0.1s">
        {
          facts.map(([n, label]) => (
            <div class="fact">
              <b>{n}</b>
              <span>{label}</span>
            </div>
          ))
        }
        <div class="reg">
          <h3>{a.reg}</h3>
          <ul>
            <li><span>{ui.footer.udyam}</span>{site.udyam}</li>
            <li><span>GSTIN</span>{site.gstin}</li>
            <li><span>{ui.footer.shopAct}</span>{site.shopAct}</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>

<style>
  .strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  .strip img {
    width: 100%;
    height: auto;
    aspect-ratio: 600 / 420;
    object-fit: cover;
    border-radius: 14px;
  }
  @media (max-width: 760px) {
    .strip {
      grid-template-columns: 1fr 1fr;
    }
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  aside {
    display: grid;
    gap: 14px;
  }
  .fact {
    display: grid;
    gap: 2px;
    padding: 18px 22px;
    background: var(--paper);
    border-radius: var(--r);
    border-left: 3px solid var(--gold);
  }
  .fact b {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--navy);
    line-height: 1;
  }
  .fact span {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .reg {
    padding: 18px 22px;
    border: 1px solid var(--line);
    border-radius: var(--r);
  }
  .reg h3 {
    font-size: 1rem;
    margin-bottom: 10px;
  }
  .reg ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }
  .reg li {
    display: grid;
  }
  .reg span {
    font-size: 0.8rem;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .two {
      grid-template-columns: 1fr;
    }
    aside {
      grid-template-columns: 1fr 1fr;
    }
    .reg {
      grid-column: 1 / -1;
    }
  }
</style>
