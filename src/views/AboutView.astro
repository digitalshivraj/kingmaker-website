---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';
import StoryPanels from '../components/StoryPanels.astro';
import { site } from '../data/site';
import { projects } from '../data/portfolio';
import type { PhotoKey } from '../data/images';
import { t } from '../i18n/ui';
import { localize, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const a = ui.about;
const ax = ui.x.about;
const L = (p: string) => localize(p, lang);
const live = projects.filter((p) => p.status === 'Live').length;
const facts = [
  [String(site.since), a.facts[0]],
  [String(projects.length), a.facts[1]],
  ['9', a.facts[2]],
  ['2', a.facts[3]],
];
const mosaic: PhotoKey[] = ['policeTeam', 'villageMeeting', 'doctorHall', 'farmerRoad', 'movers'];
const story = [
  { big: [a.h1], text: [a.p1a, a.p1b], photo: 'villageMeeting' as PhotoKey },
  { big: [a.h2], text: [a.p2a(ui.common.proprietor, live), a.p2b], photo: 'team' as PhotoKey, btn: ui.nav.products, href: L('/products/') },
  { big: [a.h3], text: [a.p3], photo: 'road' as PhotoKey, btn: ui.nav.contact, href: L('/contact/') },
];
---

<Base lang={lang} title={ui.nav.about} description={a.desc}>
  <PageHead lang={lang} title={a.title} intro={a.intro} crumbs={[{ label: ui.nav.about, href: L('/about/') }]} photo="team" />

  <section class="section tight mosaic-sec">
    <div class="wrap wide mosaic">
      {mosaic.map((m, i) => <Photo name={m} w={640} h={i === 0 ? 860 : 440} class={`m${i}`} sizes="(max-width: 760px) 50vw, 25vw" data-reveal style={`--rd: ${i * 0.07}s`} />)}
    </div>
  </section>

  <StoryPanels label={a.h1} items={story} />

  <section class="section">
    <div class="wrap">
      <ul class="stats-grid">
        {
          facts.map(([n, label], i) => (
            <li class="stat" data-reveal style={`--rd: ${i * 0.07}s`}>
              <b>{n}</b>
              <span>{label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section sand where">
    <div class="wrap">
      <div class="head center">
        <h2 class="d-md" data-reveal>{ax.offices}</h2>
      </div>
      <ul class="offices">
        {
          ax.officeRows.map(([city, role], i) => (
            <li data-reveal style={`--rd: ${i * 0.08}s`}>
              <p class="label">{`0${i + 1}`}</p>
              <h3 class="city">{city}</h3>
              <p>{role}</p>
            </li>
          ))
        }
      </ul>
      <ul class="cities" data-reveal>
        {ax.cities.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap regs">
      <h2 class="d-sm">{a.reg}</h2>
      <dl>
        <div><dt>{ui.footer.udyam}</dt><dd>{site.udyam}</dd></div>
        <div><dt>GSTIN</dt><dd>{site.gstin}</dd></div>
        <div><dt>{ui.footer.shopAct}</dt><dd>{site.shopAct}</dd></div>
        <div><dt>{ui.footer.since}</dt><dd>{site.since}</dd></div>
      </dl>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>

<style>
  .mosaic {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 16px;
  }
  .mosaic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--r-lg);
    aspect-ratio: 640 / 440;
  }
  .mosaic :global(.m0) {
    grid-row: span 2;
    aspect-ratio: auto;
  }
  .offices {
    list-style: none;
    margin: 0 0 40px;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .offices li {
    background: var(--navy);
    color: var(--on-dark);
    border-radius: var(--r-lg);
    padding: clamp(26px, 4vw, 44px);
  }
  .offices .label {
    color: var(--sky);
  }
  .city {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 1;
    text-transform: uppercase;
    color: var(--white);
    margin: 10px 0 8px;
  }
  html[lang='mr'] .city {
    text-transform: none;
    line-height: 1.2;
  }
  .cities {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .cities li {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    text-transform: uppercase;
    color: var(--navy);
    background: var(--white);
    padding: 8px 22px;
    border-radius: 999px;
    line-height: 1.2;
  }
  html[lang='mr'] .cities li {
    text-transform: none;
  }
  .regs {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 24px 64px;
    align-items: center;
  }
  .regs h2 {
    margin: 0;
  }
  .regs dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .regs dt {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .regs dd {
    margin: 4px 0 0;
    font-family: var(--font-ui);
    font-weight: 600;
    color: var(--navy);
    overflow-wrap: anywhere;
  }
  @media (max-width: 900px) {
    .mosaic {
      grid-template-columns: 1fr 1fr;
    }
    .mosaic :global(.m0) {
      grid-row: span 1;
      grid-column: span 2;
      aspect-ratio: 16 / 9;
    }
    .regs {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 1100px) {
    .regs {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 700px) {
    .regs dl {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .offices {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .regs dl {
      grid-template-columns: 1fr;
    }
  }
</style>
