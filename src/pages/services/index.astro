---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { canBuild } from '../../data/portfolio';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Services" description="Custom software, mobile apps, WhatsApp automation, AI systems, government and GeM projects, election technology, websites, digital marketing, hosting and security from Kingmaker Enterprises, Parbhani.">
  <PageHead
    title="Services"
    marathi="आमच्या सेवा"
    intro="One team for the whole job: understanding the process, designing the screens, building the software, hosting it and keeping it running."
    crumbs={[{ label: 'Services', href: '/services/' }]}
  />

  <section class="section">
    <div class="wrap">
      <div class="list">
        {
          services.map((s, i) => (
            <article class="svc">
              <a class="ic" href={`/services/${s.id}/`} aria-hidden="true" tabindex="-1">
                <Photo name={s.data.photo} w={360} h={270} sizes="200px" />
              </a>
              <div class="body">
                <p class="marathi sub">{s.data.marathi}</p>
                <h2>
                  <a href={`/services/${s.id}/`}>{s.data.title}</a>
                </h2>
                <p>{s.data.summary}</p>
                <ul class="for">
                  {s.data.forWhom.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
              </div>
              <a class="go" href={`/services/${s.id}/`} aria-label={`Read more about ${s.data.title}`}>
                <Icon name="arrow" size={22} />
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section paper">
    <div class="wrap">
      <div class="head">
        <h2>Other systems we can build</h2>
        <p>If your need is on this list, we have built something close to it. If it is not, ask anyway.</p>
      </div>
      <ul class="can">
        {
          canBuild.map((c) => (
            <li>
              <b>{c.name}</b>
              <span>{c.note}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand title="Not sure which service you need?" text="Describe the problem in a WhatsApp message, in Marathi or English. We will tell you what it takes and show you something similar we have built." />
</Base>

<style>
  .list {
    display: grid;
    gap: 0;
  }
  .svc {
    display: grid;
    grid-template-columns: 200px 1fr 48px;
    gap: 24px;
    align-items: start;
    padding: 32px 0;
    border-top: 1px solid var(--line);
  }
  .svc:last-child {
    border-bottom: 1px solid var(--line);
  }
  .ic {
    display: block;
    border-radius: 14px;
    overflow: hidden;
    background: var(--paper);
  }
  .ic img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  .sub {
    color: var(--gold-3);
    margin-bottom: 2px;
    font-size: 0.95rem;
  }
  .svc h2 {
    font-size: 1.45rem;
    margin-bottom: 6px;
  }
  .svc h2 a {
    color: var(--navy);
    text-decoration: none;
  }
  .svc h2 a:hover {
    color: var(--gold-3);
  }
  .svc p {
    color: var(--muted);
    max-width: 70ch;
  }
  .for {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .for li {
    font-size: 0.85rem;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--paper-2);
    color: var(--navy);
  }
  .go {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 2px solid var(--navy);
    display: grid;
    place-items: center;
    color: var(--navy);
    margin-top: 8px;
  }
  .go:hover {
    background: var(--navy);
    color: var(--white);
  }
  .can {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px 32px;
  }
  .can li {
    display: grid;
    gap: 4px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }
  .can b {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--navy);
  }
  .can span {
    color: var(--muted);
    font-size: 0.95rem;
  }
  @media (max-width: 800px) {
    .svc {
      grid-template-columns: 120px 1fr;
      gap: 16px;
    }
    .go {
      display: none;
    }
    .can {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .can {
      grid-template-columns: 1fr;
    }
  }
</style>
