---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site, whatsappLink } from '../../data/site';
import { projects } from '../../data/portfolio';

const gov = projects.filter((p) => p.sector === 'Government and police' || p.name === 'JanSeva');
const wa = whatsappLink('Hello Kingmaker Enterprises, I am writing from a government office and want to discuss procurement.');

const categories = [
  { t: 'Custom software and web portals', d: 'Registers, MIS dashboards, citizen service portals, department-specific applications.' },
  { t: 'Mobile applications', d: 'Field data collection, inspection apps, citizen apps in Marathi and English.' },
  { t: 'Data processing and document generation', d: 'ID cards, certificates, bulk PDF generation, data cleaning and matching, print packs.' },
  { t: 'AI and monitoring systems', d: 'Document quality checks, social media and rumour monitoring, classification of complaints.' },
  { t: 'WhatsApp and citizen communication', d: 'Official WhatsApp Business API setup, helpline chatbots, status updates to citizens.' },
  { t: 'Website development and maintenance', d: 'Department and institution websites, accessibility, hosting and annual maintenance.' },
  { t: 'Training and support', d: 'Staff training in Marathi, user guides, on-site support during pilots and rollouts.' },
];

const docs = [
  'Udyam (MSME) registration certificate',
  'GST registration certificate',
  'Maharashtra Shop and Establishment registration',
  'PAN and bank details of the firm',
  'Proposal letter and technical presentation for your department',
  'Draft work order, SLA and data protection terms',
];
---

<Base title="Government and GeM" description="Kingmaker Enterprises is a Udyam and GST registered Parbhani firm supplying software, web portals, data processing and maintenance services to government departments through GeM and departmental work orders.">
  <PageHead
    title="For government departments and public bodies"
    marathi="शासकीय विभागांसाठी"
    intro="A registered Maharashtra micro enterprise that builds and maintains software for police, district administration, civic bodies and public institutions. Pilots first, procurement through GeM or a departmental work order."
    crumbs={[{ label: 'Government', href: '/government/' }]}
  />

  <section class="section">
    <div class="wrap two">
      <div>
        <h2>Registered vendor details</h2>
        <p class="lede">Everything a procurement officer needs to check before a work order.</p>
        <table class="reg">
          <tbody>
            <tr><th>Trade name</th><td>Kingmaker Enterprises (किंगमेकर एंटरप्रायझेस)</td></tr>
            <tr><th>Legal name</th><td>{site.proprietor}</td></tr>
            <tr><th>Constitution</th><td>Proprietorship, in business since {site.since}</td></tr>
            <tr><th>Udyam registration</th><td>{site.udyam} (Micro enterprise)</td></tr>
            <tr><th>GSTIN</th><td>{site.gstin}</td></tr>
            <tr><th>Shop and Establishment</th><td>Maharashtra, receipt {site.shopAct}</td></tr>
            <tr><th>Registered activities</th><td>Computer programming (NIC 62011, 62012), web portals (63122), public order and safety services (84230), advertising and market research (73100), other business support (82990)</td></tr>
            <tr><th>Registered address</th><td>{site.address}</td></tr>
            <tr><th>Contact</th><td>{site.email}, {site.phoneDisplay}</td></tr>
          </tbody>
        </table>
      </div>
      <div class="side">
        <div class="box">
          <h3>Documents ready on request</h3>
          <ul class="check-list">
            {docs.map((d) => <li>{d}</li>)}
          </ul>
          <a class="btn gold" href={wa} target="_blank" rel="noopener">
            <Icon name="whatsapp" />
            <span>Request vendor documents</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section paper">
    <div class="wrap">
      <div class="head">
        <h2>Services available to government buyers</h2>
        <p>These can be procured through the Government e-Marketplace (GeM) or a direct departmental work order under the department's purchase rules.</p>
      </div>
      <ul class="cats">
        {
          categories.map((c) => (
            <li>
              <b>{c.t}</b>
              <span>{c.d}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div>
        <h2>How procurement works with us</h2>
        <ol class="steps">
          <li><b>Proposal</b><span>We submit a Marathi proposal letter and a presentation to the department head, with the scope, data protection terms and a pilot plan.</span></li>
          <li><b>Pilot at no cost</b><span>The department runs the system with a few real users for a month. No purchase decision is needed to start.</span></li>
          <li><b>Procurement</b><span>After the pilot, the department procures through GeM (direct purchase, bid or custom bid) or a work order, as its rules require.</span></li>
          <li><b>Rollout and maintenance</b><span>District-wide setup, staff training, user guides and an annual maintenance contract with a fixed scope.</span></li>
        </ol>
      </div>
      <div>
        <h2>Data protection commitments</h2>
        <ul class="check-list">
          <li>Data stored on servers in India, or on the department's own infrastructure</li>
          <li>Role-based access, every view and edit logged</li>
          <li>Built to the Digital Personal Data Protection Act, 2023, with retention rules agreed in writing</li>
          <li>Department owns the data and the source code at the end of the contract</li>
          <li>No third-party sharing, no advertising use, ever</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section paper">
    <div class="wrap">
      <div class="head">
        <h2>Government and civic work</h2>
      </div>
      <ul class="gov">
        {
          gov.map((p) => (
            <li>
              <b>{p.product ? <a href={`/products/${p.product}/`}>{p.name}</a> : p.name}</b>
              <span>{p.summary}</span>
              <em>{p.status}</em>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand title="Writing a proposal or tender for your department?" text="Send us the requirement. We will reply with a scope, a pilot plan and the documents your office needs." message="Hello Kingmaker Enterprises, I am writing from a government office and want to discuss a requirement." />
</Base>

<style>
  .two {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: start;
  }
  .reg {
    border-collapse: collapse;
    width: 100%;
    margin-top: 20px;
  }
  .reg th,
  .reg td {
    text-align: left;
    padding: 12px 10px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .reg th {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--navy);
    width: 220px;
    font-size: 0.95rem;
  }
  .reg td {
    color: var(--muted);
  }
  .box {
    background: var(--paper);
    border-radius: var(--r-lg);
    padding: 28px;
    display: grid;
    gap: 18px;
  }
  .box h3 {
    margin: 0;
  }
  .cats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px 32px;
  }
  .cats li {
    display: grid;
    gap: 6px;
    padding-top: 16px;
    border-top: 2px solid var(--line);
  }
  .cats b {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--navy);
  }
  .cats span {
    color: var(--muted);
    font-size: 0.97rem;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: s;
    display: grid;
    gap: 18px;
  }
  .steps li {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 14px;
    counter-increment: s;
  }
  .steps li::before {
    content: counter(s);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--navy);
    color: var(--gold-2);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 600;
    grid-row: span 2;
  }
  .steps b {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--navy);
    padding-top: 7px;
  }
  .steps span {
    color: var(--muted);
    grid-column: 2;
  }
  .gov {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px 40px;
  }
  .gov li {
    display: grid;
    gap: 4px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .gov b {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--navy);
    font-size: 1.05rem;
  }
  .gov a {
    color: var(--navy);
    text-decoration: none;
  }
  .gov span {
    color: var(--muted);
  }
  .gov em {
    font-style: normal;
    font-size: 0.85rem;
    color: var(--gold-3);
  }
  @media (max-width: 860px) {
    .two,
    .gov {
      grid-template-columns: 1fr;
    }
    .cats {
      grid-template-columns: 1fr 1fr;
    }
    .reg th {
      width: 150px;
    }
  }
  @media (max-width: 520px) {
    .cats {
      grid-template-columns: 1fr;
    }
    .reg th,
    .reg td {
      display: block;
      width: auto;
      padding: 6px 0;
    }
    .reg td {
      padding-bottom: 14px;
    }
  }
</style>
