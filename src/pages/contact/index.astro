---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import { site } from '../../data/site';
---

<Base title="Contact" description="Contact Kingmaker Enterprises, Parbhani: WhatsApp 99751 58770, contact@kingmakerenterprises.in. Free demo before you pay, replies in Marathi or English.">
  <PageHead
    title="Contact"
    marathi="संपर्क"
    intro="WhatsApp is the fastest way to reach us. Fill in the form and it opens WhatsApp with your message ready to send, or write to us by email."
    crumbs={[{ label: 'Contact', href: '/contact/' }]}
  />

  <section class="section">
    <div class="wrap two">
      <form id="contact-form" class="form" novalidate>
        <h2>Send a message</h2>
        <div class="row">
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="row">
          <label for="org">Office or organisation</label>
          <input id="org" name="org" type="text" autocomplete="organization" placeholder="Police station, hospital, dealer, party office" />
        </div>
        <div class="row">
          <label for="phone">Your mobile number</label>
          <input id="phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel" />
        </div>
        <div class="row">
          <label for="need">What do you need?</label>
          <select id="need" name="need">
            <option>A demo of one of your products</option>
            <option>Custom software or portal</option>
            <option>Mobile app</option>
            <option>WhatsApp chatbot or automation</option>
            <option>AI or automation system</option>
            <option>Government or GeM project</option>
            <option>Election or campaign technology</option>
            <option>Website, SEO or AI search visibility</option>
            <option>Digital marketing and ads</option>
            <option>Brand identity, decks or documents</option>
            <option>Hosting, server or maintenance</option>
            <option>Something else</option>
          </select>
        </div>
        <div class="row">
          <label for="msg">Message (Marathi or English)</label>
          <textarea id="msg" name="msg" rows="5" placeholder="Tell us about the office or business and the problem to solve."></textarea>
        </div>
        <p class="err" id="form-err" hidden>Please enter your name so we know who is writing.</p>
        <div class="actions">
          <button class="btn gold" type="submit">
            <Icon name="whatsapp" />
            <span>Send on WhatsApp</span>
          </button>
          <button class="btn ghost" type="button" id="mail-btn">
            <Icon name="mail" />
            <span>Send by email instead</span>
          </button>
        </div>
        <p class="note">Nothing is stored on this website. The message opens in your WhatsApp or email app and you send it yourself.</p>
      </form>

      <aside>
        <Photo name="road" w={700} h={400} class="aside-photo" sizes="(max-width: 860px) 100vw, 40vw" />
        <div class="card">
          <h3>Direct</h3>
          <ul>
            <li>
              <Icon name="whatsapp" size={20} />
              <div>
                <a href={site.whatsapp} target="_blank" rel="noopener">{site.phoneDisplay}</a>
                <span>WhatsApp, Marathi or English</span>
              </div>
            </li>
            <li>
              <Icon name="phone" size={20} />
              <div>
                <a href={`tel:${site.phoneIntl}`}>{site.phoneDisplay}</a>
                <span>{site.hours}</span>
              </div>
            </li>
            <li>
              <Icon name="mail" size={20} />
              <div>
                <a href={`mailto:${site.email}`}>{site.email}</a>
                <span>Reply within one working day</span>
              </div>
            </li>
            <li>
              <Icon name="pin" size={20} />
              <div>
                <span class="addr">{site.address}</span>
                <span class="marathi">{site.addressMarathi}</span>
              </div>
            </li>
          </ul>
        </div>
        <div class="card">
          <h3>Meetings</h3>
          <p>
            We visit offices in Parbhani, Nanded, Hingoli, Latur, Beed and Chhatrapati Sambhajinagar. For other districts
            and states, we start with a video call and a demo link.
          </p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .two {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: start;
  }
  .form {
    display: grid;
    gap: 18px;
  }
  .form h2 {
    margin-bottom: 4px;
  }
  .row {
    display: grid;
    gap: 6px;
  }
  label {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--navy);
  }
  input,
  select,
  textarea {
    font: inherit;
    padding: 12px 14px;
    border: 1.5px solid var(--line);
    border-radius: 10px;
    background: var(--white);
    color: var(--text);
    min-height: 48px;
  }
  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--navy);
    outline: 3px solid rgba(201, 149, 46, 0.35);
    outline-offset: 0;
  }
  textarea {
    resize: vertical;
  }
  .err {
    color: #a3341d;
    font-weight: 500;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .note {
    font-size: 0.9rem;
    color: var(--muted);
  }
  aside {
    display: grid;
    gap: 20px;
  }
  .aside-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 700 / 400;
    object-fit: cover;
    border-radius: var(--r-lg);
  }
  .card {
    background: var(--paper);
    border-radius: var(--r-lg);
    padding: 26px;
  }
  .card h3 {
    margin-bottom: 14px;
  }
  .card p {
    color: var(--muted);
  }
  .card ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .card li {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 12px;
    align-items: start;
  }
  .card svg {
    color: var(--gold-3);
    margin-top: 5px;
  }
  .card li div {
    display: grid;
    gap: 2px;
  }
  .card li a {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--navy);
    text-decoration: none;
  }
  .card li a:hover {
    color: var(--gold-3);
  }
  .card li span {
    font-size: 0.92rem;
    color: var(--muted);
  }
  .addr {
    color: var(--text) !important;
    font-size: 1rem !important;
  }
  @media (max-width: 860px) {
    .two {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const err = document.getElementById('form-err') as HTMLElement;
  const field = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement).value.trim();

  function compose() {
    const name = field('name');
    if (!name) {
      err.hidden = false;
      (document.getElementById('name') as HTMLInputElement).focus();
      return null;
    }
    err.hidden = true;
    const lines = [
      `Hello Kingmaker Enterprises, I am ${name}.`,
      field('org') && `Organisation: ${field('org')}`,
      field('phone') && `Mobile: ${field('phone')}`,
      `Need: ${field('need')}`,
      field('msg') && `Message: ${field('msg')}`,
    ].filter(Boolean);
    return lines.join('\n');
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const text = compose();
    if (!text) return;
    window.open(`https://wa.me/919975158770?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
  });

  document.getElementById('mail-btn')?.addEventListener('click', () => {
    const text = compose();
    if (!text) return;
    const subject = `Enquiry: ${field('need')}`;
    window.location.href = `mailto:contact@kingmakerenterprises.in?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(text)}`;
  });
</script>
