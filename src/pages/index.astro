---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import ProductMock from '../components/ProductMock.astro';
import CtaBand from '../components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { projects } from '../data/portfolio';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const featured = products.slice(0, 4);
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);

const sectors = [
  { icon: 'shield', name: 'Police and district administration', note: 'Lodge registers, monitoring, MIS' },
  { icon: 'landmark', name: 'MLA, MP and civic offices', note: 'Citizen services, grievances, outreach' },
  { icon: 'users', name: 'Political organisations', note: 'War rooms, karyakarta apps, booths' },
  { icon: 'hospital', name: 'Hospitals and clinics', note: 'OPD to IPD, booking, queues' },
  { icon: 'tractor', name: 'Dealers and farmers', note: 'Subsidy tracking, scheme updates' },
  { icon: 'truck', name: 'Logistics and business', note: 'Franchise panels, CRMs, ledgers' },
];

const steps = [
  { t: 'Understand', d: 'We meet your team, in person in Marathwada or on a call, and write the process down in plain Marathi or English.' },
  { t: 'Demo on a free link', d: 'You click through a working demo with your own names and forms before any payment.' },
  { t: 'Pilot with real users', d: 'Two or three lodges, one ward, one clinic. Small enough to run safely, real enough to judge.' },
  { t: 'Roll out and train', d: 'Staff training, a Marathi user guide, data migration and go-live support.' },
  { t: 'Maintain', d: 'Hosting, backups, updates and a fixed monthly scope, with you owning the data and the code.' },
];

const fmt = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base title={site.name} description="Kingmaker Enterprises builds software, web portals, mobile apps, WhatsApp automation and AI systems for government offices, police, hospitals, political organisations and businesses in Maharashtra. Udyam and GST registered, Parbhani.">
  <Hero />

  <section class="section tight sectors">
    <div class="wrap">
      <ul>
        {
          sectors.map((s) => (
            <li>
              <Icon name={s.icon} size={28} />
              <b>{s.name}</b>
              <span>{s.note}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section products">
    <div class="wrap">
      <div class="head">
        <h2>Platforms we have already built and can deploy for you</h2>
        <p>
          Each of these started with one client's real problem. They are ready to run for the next district, office or
          hospital, with the changes your process needs.
        </p>
      </div>
      <div class="feature-list">
        {
          featured.map((p, i) => (
            <article class:list={['feature', { flip: i % 2 === 1 }]}>
              <div class="text">
                <p class="marathi sector">{p.data.marathi}</p>
                <h3>
                  <a href={`/products/${p.id}/`}>{p.data.title}</a>
                </h3>
                <p class="tag">{p.data.tagline}</p>
                <ul class="check-list">
                  {p.data.highlights.slice(0, 3).map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
                <a class="more" href={`/products/${p.id}/`}>
                  Read about {p.data.title}
                </a>
              </div>
              <div class="visual">
                <ProductMock variant={p.data.mock} title={p.data.title} />
              </div>
            </article>
          ))
        }
      </div>
      <div class="all">
        <a class="btn navy" href="/products/">All {projects.length} projects and products</a>
      </div>
    </div>
  </section>

  <section class="section paper services">
    <div class="wrap">
      <div class="head">
        <h2>What we do</h2>
        <p>From a first website to a district-wide system, one team handles design, development, hosting and support.</p>
      </div>
      <ul class="service-list">
        {
          services.map((s) => (
            <li>
              <Icon name={s.data.icon} size={26} />
              <div>
                <h3>
                  <a href={`/services/${s.id}/`}>{s.data.title}</a>
                </h3>
                <p>{s.data.summary}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section process">
    <div class="wrap grid2">
      <div class="head">
        <h2>How a project runs</h2>
        <p>
          Government offices and small businesses have been burnt by software that was paid for and never used. Our process
          is built so you never pay for something you have not seen working.
        </p>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li>
              <span class="n">{i + 1}</span>
              <div>
                <h3>{s.t}</h3>
                <p>{s.d}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section ink why">
    <div class="wrap">
      <div class="head">
        <h2>Why offices in Marathwada work with us</h2>
      </div>
      <div class="why-grid">
        <div>
          <h3>A registered firm, not a freelancer</h3>
          <p>Udyam MSME, GST and Maharashtra Shop Act registered. We can be a vendor on departmental work orders and the Government e-Marketplace.</p>
        </div>
        <div>
          <h3>Marathi first</h3>
          <p>Our proposals, screens, user guides and WhatsApp messages are written in the Marathi your constables, clerks and farmers read every day.</p>
        </div>
        <div>
          <h3>See it before you pay</h3>
          <p>Every project starts with a working demo on a free link. Pilots run with real users. You decide after you have seen results.</p>
        </div>
        <div>
          <h3>Local and reachable</h3>
          <p>Based in Parbhani, present across Nanded, Parbhani, Hingoli, Latur and Chhatrapati Sambhajinagar, one WhatsApp message away.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section tight gem">
    <div class="wrap gem-inner">
      <div>
        <h2>Buying for a government department?</h2>
        <p>
          Our software development, web portal, data processing and maintenance services can be procured through the
          Government e-Marketplace or a departmental work order. Our registrations and documents are ready.
        </p>
      </div>
      <a class="btn ghost" href="/government/">Government and GeM</a>
    </div>
  </section>

  <section class="section blog">
    <div class="wrap">
      <div class="head">
        <h2>From the blog</h2>
        <p>Plain explanations of digital systems for offices, hospitals and businesses, written for Maharashtra.</p>
      </div>
      <div class="post-grid">
        {
          posts.map((p) => (
            <article>
              <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
              <h3>
                <a href={`/blog/${p.id}/`}>{p.data.title}</a>
              </h3>
              <p>{p.data.description}</p>
            </article>
          ))
        }
      </div>
      <div class="all">
        <a class="btn ghost" href="/blog/">All articles</a>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .sectors {
    border-bottom: 1px solid var(--line);
  }
  .sectors ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 24px;
  }
  .sectors li {
    display: grid;
    gap: 6px;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .sectors svg {
    color: var(--gold-3);
    margin-bottom: 4px;
  }
  .sectors b {
    color: var(--navy);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .feature-list {
    display: grid;
    gap: clamp(48px, 7vw, 88px);
  }
  .feature {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }
  .feature.flip .text {
    order: 2;
  }
  .sector {
    color: var(--gold-3);
    margin-bottom: 6px;
  }
  .feature h3 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }
  .feature h3 a {
    color: var(--navy);
    text-decoration: none;
  }
  .feature h3 a:hover {
    color: var(--gold-3);
  }
  .tag {
    font-size: 1.1rem;
    color: var(--muted);
    margin-bottom: 18px;
  }
  .more {
    display: inline-block;
    margin-top: 20px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .all {
    margin-top: clamp(40px, 6vw, 64px);
    text-align: center;
  }

  .service-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px 40px;
  }
  .service-list li {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 16px;
    align-items: start;
    padding-top: 18px;
    border-top: 2px solid var(--line);
  }
  .service-list svg {
    color: var(--gold-3);
    margin-top: 4px;
  }
  .service-list h3 {
    font-size: 1.1rem;
    margin-bottom: 6px;
  }
  .service-list h3 a {
    color: var(--navy);
    text-decoration: none;
  }
  .service-list h3 a:hover {
    color: var(--gold-3);
  }
  .service-list p {
    font-size: 0.98rem;
    color: var(--muted);
  }

  .grid2 {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 22px;
  }
  .steps li {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 18px;
  }
  .n {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--navy);
    color: var(--gold-2);
    font-family: var(--font-display);
    font-weight: 600;
    display: grid;
    place-items: center;
  }
  .steps h3 {
    font-size: 1.15rem;
    margin-bottom: 4px;
    padding-top: 8px;
  }
  .steps p {
    color: var(--muted);
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  .why-grid h3 {
    font-size: 1.15rem;
    padding-top: 16px;
    border-top: 2px solid var(--gold);
  }

  .gem {
    background: var(--paper);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .gem-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: center;
  }
  .gem h2 {
    font-size: 1.5rem;
  }
  .gem p {
    color: var(--muted);
    max-width: 70ch;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .post-grid article {
    padding-top: 16px;
    border-top: 2px solid var(--line);
  }
  .post-grid time {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .post-grid h3 {
    font-size: 1.2rem;
    margin: 8px 0;
  }
  .post-grid h3 a {
    color: var(--navy);
    text-decoration: none;
  }
  .post-grid h3 a:hover {
    color: var(--gold-3);
  }
  .post-grid p {
    color: var(--muted);
    font-size: 0.98rem;
  }

  @media (max-width: 1000px) {
    .sectors ul {
      grid-template-columns: repeat(3, 1fr);
    }
    .service-list,
    .post-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .why-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 760px) {
    .feature,
    .feature.flip {
      grid-template-columns: 1fr;
    }
    .feature.flip .text {
      order: 0;
    }
    .grid2,
    .gem-inner {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .sectors ul {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 16px;
    }
    .service-list,
    .post-grid,
    .why-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
