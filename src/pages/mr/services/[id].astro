---
import ServiceView from '../../../views/ServiceView.astro';
import { getCollection } from 'astro:content';
import { byLang, entrySlug } from '../../../i18n/utils';

export async function getStaticPaths() {
  const entries = byLang(await getCollection('services'), 'mr');
  return entries.map((e) => ({ params: { id: entrySlug(e.id) }, props: { service: e } }));
}

const { service } = Astro.props;
---

<ServiceView lang="mr" service={service} />
