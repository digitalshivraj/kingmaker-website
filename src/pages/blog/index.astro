---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Base title="Blog" description="Articles from Kingmaker Enterprises on software for government offices, police, hospitals, political organisations and businesses in Maharashtra, written in plain language.">
  <PageHead
    title="Blog"
    marathi="लेख"
    intro="Plain explanations of digital systems, data rules and practical technology for offices, hospitals and businesses in Maharashtra."
    crumbs={[{ label: 'Blog', href: '/blog/' }]}
  >
    <p class="tags">{tags.map((t) => <span>{t}</span>)}</p>
  </PageHead>

  <section class="section">
    <div class="wrap">
      <div class="posts">
        {
          posts.map((p) => (
            <article>
              <div class="meta">
                <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
                <span>{p.data.readingMinutes} min read</span>
              </div>
              <h2>
                <a href={`/blog/${p.id}/`}>{p.data.title}</a>
              </h2>
              <p>{p.data.description}</p>
              <div class="post-tags">
                {p.data.tags.map((t) => (
                  <span>{t}</span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }
  .tags span {
    font-size: 0.85rem;
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: var(--on-dark-muted);
  }
  .posts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px 56px;
  }
  article {
    padding-top: 18px;
    border-top: 2px solid var(--line);
  }
  .meta {
    display: flex;
    gap: 16px;
    font-size: 0.88rem;
    color: var(--muted);
  }
  h2 {
    font-size: 1.45rem;
    margin: 10px 0 8px;
  }
  h2 a {
    color: var(--navy);
    text-decoration: none;
  }
  h2 a:hover {
    color: var(--gold-3);
  }
  article p {
    color: var(--muted);
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }
  .post-tags span {
    font-size: 0.8rem;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--paper-2);
    color: var(--navy);
  }
  @media (max-width: 760px) {
    .posts {
      grid-template-columns: 1fr;
    }
  }
</style>
