---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title="Page not found" description="The page you asked for does not exist on kingmakerenterprises.in." noindex>
  <section class="section nf">
    <div class="wrap">
      <p class="marathi">पान सापडले नाही</p>
      <h1>This page does not exist</h1>
      <p class="lede">The link may be old or mistyped. These pages will get you back on track.</p>
      <div class="links">
        <a class="btn navy" href="/">Home</a>
        <a class="btn ghost" href="/services/">Services</a>
        <a class="btn ghost" href="/products/">Products</a>
        <a class="btn ghost" href="/contact/">Contact</a>
      </div>
      <p class="small">Or message us on WhatsApp at {site.phoneDisplay}.</p>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 60vh;
  }
  .marathi {
    color: var(--gold-3);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 28px 0 20px;
  }
  .small {
    color: var(--muted);
  }
</style>
