---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { t } from '../i18n/ui';
const en = t('en');
const mr = t('mr');
---

<Base lang="en" title="Page not found" description="The page you asked for does not exist on kingmakerenterprises.in." noindex hasAlt={false} altPath="/mr/">
  <section class="section nf">
    <div class="wrap">
      <p class="marathi">{mr.notFound.h1}</p>
      <h1>{en.notFound.h1}</h1>
      <p class="lede">{en.notFound.p}</p>
      <div class="links">
        <a class="btn navy" href="/">{en.nav.home}</a>
        <a class="btn ghost" href="/services/">{en.nav.services}</a>
        <a class="btn ghost" href="/products/">{en.nav.products}</a>
        <a class="btn ghost" href="/contact/">{en.nav.contact}</a>
        <a class="btn ghost" href="/mr/" lang="mr">{mr.nav.home} (मराठी)</a>
      </div>
      <p class="small">{en.notFound.wa(site.phoneDisplay)}</p>
      <p class="small marathi" lang="mr">{mr.notFound.p} {mr.notFound.wa(site.phoneDisplay)}</p>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 60vh;
  }
  .marathi {
    color: var(--gold-3);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 28px 0 20px;
  }
  .small {
    color: var(--muted);
  }
</style>
