---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ProductMock from '../../components/ProductMock.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection, render } from 'astro:content';
import { whatsappLink } from '../../data/site';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((p) => ({ params: { id: p.id }, props: { product: p } }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const all = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const others = all.filter((p) => p.id !== product.id).slice(0, 3);
const wa = whatsappLink(`Hello Kingmaker Enterprises, I want a demo of ${product.data.title}.`);
---

<Base title={product.data.title} description={`${product.data.title}: ${product.data.tagline}. ${product.data.highlights[0]}.`}>
  <PageHead
    title={product.data.title}
    marathi={product.data.marathi}
    intro={product.data.tagline}
    crumbs={[
      { label: 'Products', href: '/products/' },
      { label: product.data.title, href: `/products/${product.id}/` },
    ]}
  />

  <section class="section top">
    <div class="wrap grid">
      <div>
        <h2>What it does</h2>
        <ul class="check-list big">
          {product.data.highlights.map((h) => <li>{h}</li>)}
        </ul>
        <div class="actions">
          <a class="btn gold" href={wa} target="_blank" rel="noopener">
            <Icon name="whatsapp" />
            <span>Request a demo</span>
          </a>
          <span class="status">{product.data.status}</span>
        </div>
      </div>
      <div class="visual">
        <ProductMock variant={product.data.mock} title={product.data.title} />
      </div>
    </div>
  </section>

  <section class="section paper">
    <div class="wrap layout">
      <div class="prose">
        <Content />
      </div>
      <aside>
        <div class="box">
          <h3>Who uses it</h3>
          <ul class="plain">
            {product.data.users.map((u) => <li>{u}</li>)}
          </ul>
        </div>
        <div class="box">
          <h3>Sector</h3>
          <p>{product.data.sector}</p>
        </div>
        <div class="box">
          <h3>Other platforms</h3>
          <ul class="plain">
            {others.map((o) => <li><a href={`/products/${o.id}/`}>{o.data.title}</a></li>)}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <CtaBand title={`See ${product.data.title} with your own data`} text="We set up a demo with your office names, wards or departments, free, and walk you through it on a call or in person." message={`Hello Kingmaker Enterprises, I want a demo of ${product.data.title}.`} />
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: center;
  }
  .big {
    font-size: 1.08rem;
    gap: 14px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 28px;
  }
  .status {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  .box {
    background: var(--white);
    border-radius: var(--r);
    padding: 22px;
    margin-bottom: 20px;
  }
  .box h3 {
    font-size: 1.05rem;
    margin-bottom: 10px;
  }
  .box p {
    color: var(--muted);
  }
  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .grid,
    .layout {
      grid-template-columns: 1fr;
    }
  }
</style>
