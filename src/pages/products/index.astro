---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ProductMock from '../../components/ProductMock.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { projects, sectors } from '../../data/portfolio';
import { whatsappLink } from '../../data/site';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<Base title="Products and projects" description={`${products.length} ready platforms and ${projects.length} projects across government, police, elections, healthcare, agriculture, logistics, finance, marketing and AI, built by Kingmaker Enterprises.`}>
  <PageHead
    title="Products and projects"
    marathi="आमची उत्पादने व प्रकल्प"
    intro={`${products.length} platforms ready to deploy and ${projects.length} projects delivered or in progress. Every one started with a real client and a real problem.`}
    crumbs={[{ label: 'Products', href: '/products/' }]}
  >
    <nav class="jump" aria-label="Sectors">
      {sectors.map((s) => <a href={`#${slug(s)}`}>{s}</a>)}
    </nav>
  </PageHead>

  <section class="section">
    <div class="wrap">
      <div class="head">
        <h2>Ready platforms</h2>
        <p>Built, demonstrated and ready to be set up for your office, hospital or business.</p>
      </div>
      <div class="flag-grid">
        {
          products.map((p) => (
            <article class="flag">
              <a href={`/products/${p.id}/`} class="vis" aria-label={p.data.title}>
                <ProductMock variant={p.data.mock} title={p.data.title} compact />
              </a>
              <p class="marathi sub">{p.data.marathi}</p>
              <h3>
                <a href={`/products/${p.id}/`}>{p.data.title}</a>
              </h3>
              <p>{p.data.tagline}</p>
              <span class="status">{p.data.status}</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section paper">
    <div class="wrap">
      <div class="head">
        <h2>All projects by sector</h2>
        <p>Live systems, pilots, demos and builds in progress. Ask about any of them on WhatsApp.</p>
      </div>
      {
        sectors.map((sec) => {
          const list = projects.filter((p) => p.sector === sec);
          return (
            <div class="sector" id={slug(sec)}>
              <h3>{sec}</h3>
              <ul>
                {list.map((p) => (
                  <li>
                    <div class="name">
                      <b>{p.product ? <a href={`/products/${p.product}/`}>{p.name}</a> : p.name}</b>
                      {p.marathi && <span class="marathi">{p.marathi}</span>}
                    </div>
                    <p>{p.summary}</p>
                    <div class="meta">
                      <span class={`st ${slug(p.status)}`}>{p.status}</span>
                      {p.stack && <span class="stack">{p.stack}</span>}
                      <a href={whatsappLink(`Hello Kingmaker Enterprises, I want to know more about ${p.name}.`)} target="_blank" rel="noopener">
                        Ask about this
                      </a>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>
  </section>

  <CtaBand title="Want a demo of any of these?" text="Tell us which one and for whom. We set up a demo link with your names and forms, free, and walk you through it on a call." message="Hello Kingmaker Enterprises, I want a demo of one of your products." />
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }
  .jump a {
    font-size: 0.88rem;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: var(--on-dark);
    text-decoration: none;
  }
  .jump a:hover {
    border-color: var(--gold-2);
    color: var(--gold-2);
  }
  .flag-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px 48px;
  }
  .flag .vis {
    display: block;
    margin-bottom: 18px;
    text-decoration: none;
    color: inherit;
  }
  .sub {
    color: var(--gold-3);
    margin-bottom: 2px;
  }
  .flag h3 {
    font-size: 1.4rem;
    margin-bottom: 4px;
  }
  .flag h3 a {
    color: var(--navy);
    text-decoration: none;
  }
  .flag h3 a:hover {
    color: var(--gold-3);
  }
  .flag p {
    color: var(--muted);
  }
  .status {
    display: inline-block;
    margin-top: 10px;
    font-size: 0.85rem;
    color: var(--navy);
    background: var(--paper-2);
    padding: 4px 12px;
    border-radius: 999px;
  }
  .sector {
    padding-top: 28px;
    margin-top: 28px;
    border-top: 2px solid var(--line);
    scroll-margin-top: 90px;
  }
  .sector h3 {
    font-size: 1.35rem;
    margin-bottom: 18px;
  }
  .sector ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px 40px;
  }
  .sector li {
    display: grid;
    gap: 6px;
    align-content: start;
  }
  .name {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    align-items: baseline;
  }
  .name b {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--navy);
    font-size: 1.05rem;
  }
  .name a {
    color: var(--navy);
    text-decoration: none;
  }
  .name a:hover {
    color: var(--gold-3);
  }
  .name .marathi {
    color: var(--gold-3);
    font-size: 0.95rem;
  }
  .sector p {
    color: var(--muted);
    font-size: 0.98rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    align-items: center;
    font-size: 0.85rem;
  }
  .st {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--paper-2);
    color: var(--navy);
  }
  .st.live {
    background: #dff3e7;
    color: #1f6b43;
  }
  .st.pilot,
  .st.demo-ready {
    background: #e3ecf8;
    color: #1f467c;
  }
  .st.in-build {
    background: #fbefd6;
    color: #7a5410;
  }
  .stack {
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .flag-grid,
    .sector ul {
      grid-template-columns: 1fr;
    }
  }
</style>
